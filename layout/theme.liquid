<!doctype html>
<html lang="he" class="no-js" dir="rtl">
  <head>
    <script>document.documentElement.className = document.documentElement.className.replace('no-js', 'js');</script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    {%- comment -%} Preload critical hero image for fast LCP {%- endcomment -%}
    <link rel="preload" href="{{ 'hero-bg.png' | asset_url }}" as="image" media="(min-width: 769px)">
    <link rel="preload" href="{{ 'hero-bg-mobile.png' | asset_url }}" as="image" media="(max-width: 768px)">

    {%- comment -%} CSS: Bootstrap for grid utilities, then our theme overrides everything {%- endcomment -%}
    {{ 'bootstrap.rtl.min.css' | asset_url | stylesheet_tag }}
    {{ 'babet-style.css' | asset_url | stylesheet_tag }}
    {{ 'rtl-overrides.css' | asset_url | stylesheet_tag }}
    {{ 'pets-paradise.css' | asset_url | stylesheet_tag }}

    {%- comment -%} SEO meta tags {%- endcomment -%}
    {% render 'meta-tags' %}

    {{ content_for_header }}
  </head>

  <body class="home3_pet_shop">

    {%- comment -%} Old theme snippets removed for performance — our header handles cart sidebar + mobile menu {%- endcomment -%}

    {%- comment -%} Header {%- endcomment -%}
    {% sections 'header-group' %}

    {%- comment -%} Main content {%- endcomment -%}
    <main>
      {{ content_for_layout }}
    </main>

    {%- comment -%} Footer {%- endcomment -%}
    {% sections 'footer-group' %}

    {%- comment -%} JS: only our theme script — no jQuery, no unused vendor libs {%- endcomment -%}
    <script src="{{ 'pets-paradise.js' | asset_url }}" defer></script>
  </body>
</html>
