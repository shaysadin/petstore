<div class="pp-article-hero">
  <div class="pp-article-hero__inner">
    <nav class="pp-breadcrumb" aria-label="ניווט">
      <a href="/" class="pp-breadcrumb__item">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        דף הבית
      </a>
      <svg class="pp-breadcrumb__chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M15 18L9 12L15 6"/></svg>
      <a href="{{ blog.url }}" class="pp-breadcrumb__item">{{ blog.title }}</a>
      <svg class="pp-breadcrumb__chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M15 18L9 12L15 6"/></svg>
      <span class="pp-breadcrumb__item pp-breadcrumb__item--current">{{ article.title | truncate: 40 }}</span>
    </nav>
    <h1 class="pp-article-hero__title">{{ article.title }}</h1>
    <div class="pp-article-hero__meta">
      <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
        {{ article.published_at | date: '%d/%m/%Y' }}
      </time>
      {%- if article.author != blank -%}
        <span class="pp-article-hero__meta-sep">•</span>
        <span>{{ article.author }}</span>
      {%- endif -%}
    </div>
  </div>
</div>

<article class="pp-article-section">
  <div class="pp-article-content">
    {%- if article.image -%}
      <div class="pp-article-featured-img">
        <img
          src="{{ article.image | image_url: width: 1200 }}"
          alt="{{ article.image.alt | default: article.title | escape }}"
          loading="eager"
        >
      </div>
    {%- endif -%}

    <div class="pp-article-body">
      {{ article.content }}
    </div>

    {%- if article.tags.size > 0 -%}
      <div class="pp-article-tags">
        {%- for tag in article.tags -%}
          <a href="{{ blog.url }}/tagged/{{ tag | handle }}" class="pp-article-tag">{{ tag }}</a>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="pp-article-back">
      <a href="{{ blog.url }}" class="pp-article-back__link">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
        חזרה לבלוג
      </a>
    </div>
  </div>

  {%- if blog.comments_enabled? -%}
    <div class="pp-article-comments" id="comments">
      <h2 class="pp-article-comments__title">תגובות</h2>

      {% paginate article.comments by 10 %}
        {%- if article.comments_count > 0 -%}
          <div class="pp-article-comments__list">
            {%- for comment in article.comments -%}
              <div class="pp-article-comment">
                <div class="pp-article-comment__avatar">
                  {{ comment.author | slice: 0 }}
                </div>
                <div class="pp-article-comment__body">
                  <div class="pp-article-comment__header">
                    <span class="pp-article-comment__author">{{ comment.author }}</span>
                    <time class="pp-article-comment__date" datetime="{{ comment.created_at | date: '%Y-%m-%d' }}">
                      {{ comment.created_at | date: '%d/%m/%Y' }}
                    </time>
                  </div>
                  <div class="pp-article-comment__content">{{ comment.content }}</div>
                </div>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if paginate.pages > 1 -%}
          <div class="pp-pagination pp-pagination--comments">
            {%- if paginate.previous -%}
              <a href="{{ paginate.previous.url }}#comments" class="pp-pagination__arrow" aria-label="עמוד קודם">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            {%- endif -%}
            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}
                <a href="{{ part.url }}#comments" class="pp-pagination__num">{{ part.title }}</a>
              {%- else -%}
                <span class="pp-pagination__num pp-pagination__num--active">{{ part.title }}</span>
              {%- endif -%}
            {%- endfor -%}
            {%- if paginate.next -%}
              <a href="{{ paginate.next.url }}#comments" class="pp-pagination__arrow" aria-label="עמוד הבא">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      {% endpaginate %}

      {% form 'new_comment', article %}
        <div class="pp-article-comment-form">
          <h3 class="pp-article-comment-form__title">השאר תגובה</h3>

          {{ form.errors | default_errors }}

          <div class="pp-article-comment-form__row">
            <div class="pp-article-comment-form__field">
              <label for="author" class="pp-article-comment-form__label">שם</label>
              <input type="text" name="comment[author]" id="author" value="{{ form.author }}" required class="pp-article-comment-form__input">
            </div>
            <div class="pp-article-comment-form__field">
              <label for="email" class="pp-article-comment-form__label">אימייל</label>
              <input type="email" name="comment[email]" id="email" value="{{ form.email }}" required class="pp-article-comment-form__input">
            </div>
          </div>

          <div class="pp-article-comment-form__field">
            <label for="body" class="pp-article-comment-form__label">תגובה</label>
            <textarea name="comment[body]" id="body" required class="pp-article-comment-form__textarea" rows="5">{{ form.body }}</textarea>
          </div>

          <button type="submit" class="pp-btn pp-btn--primary pp-article-comment-form__submit">שלח תגובה</button>
        </div>
      {% endform %}
    </div>
  {%- endif -%}
</article>

<style>
  /* === Article Hero === */
  .pp-article-hero {
    background: var(--pp-brown);
    padding: 48px 40px 56px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .pp-article-hero__inner {
    position: relative;
    z-index: 1;
    max-width: 800px;
    margin: 0 auto;
  }
  .pp-article-hero__title {
    font-family: var(--pp-font);
    font-weight: 800;
    font-size: clamp(28px, 4vw, 44px);
    color: var(--pp-cream);
    margin: 16px 0 18px;
    line-height: 1.25;
  }
  .pp-article-hero__meta {
    font-family: var(--pp-font);
    font-size: 15px;
    color: var(--pp-cream);
    opacity: 0.7;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
  }
  .pp-article-hero__meta-sep {
    opacity: 0.5;
  }

  /* === Breadcrumb (in hero) === */
  .pp-article-hero .pp-breadcrumb {
    font-family: var(--pp-font);
    font-size: 13px;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 247, 236, 0.12);
    border: 1px solid rgba(255, 247, 236, 0.15);
    backdrop-filter: blur(6px);
    border-radius: 50px;
    padding: 8px 20px;
    margin-bottom: 4px;
  }
  .pp-article-hero .pp-breadcrumb__item {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--pp-cream);
    text-decoration: none;
    opacity: 0.75;
    transition: opacity 0.2s ease;
  }
  .pp-article-hero a.pp-breadcrumb__item:hover { opacity: 1; }
  .pp-article-hero .pp-breadcrumb__item--current {
    color: var(--pp-orange);
    opacity: 1;
    font-weight: 700;
  }
  .pp-article-hero .pp-breadcrumb__chevron {
    color: var(--pp-cream);
    opacity: 0.4;
    flex-shrink: 0;
  }

  /* === Article Section === */
  .pp-article-section {
    max-width: 1440px;
    margin: 0 auto;
    padding: 40px 40px 80px;
    background: var(--pp-white);
  }

  /* === Article Content === */
  .pp-article-content {
    max-width: 800px;
    margin: 0 auto;
  }
  .pp-article-featured-img {
    margin-bottom: 40px;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 4px 24px rgba(0,0,0,0.1);
  }
  .pp-article-featured-img img {
    width: 100%;
    display: block;
    aspect-ratio: 16/9;
    object-fit: cover;
  }

  /* === Article Body Typography === */
  .pp-article-body {
    font-family: var(--pp-font);
    font-size: 17px;
    line-height: 1.85;
    color: var(--pp-brown);
    text-align: right;
    margin-bottom: 40px;
  }
  .pp-article-body h2 {
    font-size: 26px;
    font-weight: 700;
    color: var(--pp-brown);
    margin: 40px 0 16px;
    line-height: 1.3;
  }
  .pp-article-body h3 {
    font-size: 22px;
    font-weight: 700;
    color: var(--pp-brown);
    margin: 32px 0 12px;
    line-height: 1.3;
  }
  .pp-article-body h4 {
    font-size: 19px;
    font-weight: 700;
    color: var(--pp-brown);
    margin: 28px 0 10px;
  }
  .pp-article-body p {
    margin-bottom: 18px;
  }
  .pp-article-body a {
    color: var(--pp-orange);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: opacity 0.2s;
  }
  .pp-article-body a:hover {
    opacity: 0.8;
  }
  .pp-article-body ul,
  .pp-article-body ol {
    padding-right: 24px;
    margin-bottom: 18px;
  }
  .pp-article-body li {
    margin-bottom: 8px;
  }
  .pp-article-body img {
    max-width: 100%;
    height: auto;
    border-radius: 16px;
    margin: 24px 0;
  }
  .pp-article-body blockquote {
    border-right: 4px solid var(--pp-orange);
    padding: 16px 24px;
    margin: 24px 0;
    background: var(--pp-cream);
    border-radius: 0 12px 12px 0;
    font-style: italic;
    color: var(--pp-brown);
    opacity: 0.9;
  }
  .pp-article-body table {
    width: 100%;
    border-collapse: collapse;
    margin: 24px 0;
    font-size: 15px;
  }
  .pp-article-body th,
  .pp-article-body td {
    padding: 12px 16px;
    border: 1px solid rgba(80, 30, 21, 0.1);
    text-align: right;
  }
  .pp-article-body th {
    background: var(--pp-cream);
    font-weight: 700;
  }

  /* === Tags === */
  .pp-article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 40px;
    padding-top: 24px;
    border-top: 1px solid rgba(80, 30, 21, 0.08);
  }
  .pp-article-tag {
    font-family: var(--pp-font);
    font-size: 13px;
    font-weight: 600;
    color: var(--pp-brown);
    background: var(--pp-cream);
    padding: 6px 16px;
    border-radius: 20px;
    text-decoration: none;
    transition: background 0.2s, color 0.2s;
  }
  .pp-article-tag:hover {
    background: var(--pp-orange);
    color: #fff;
  }

  /* === Back Link === */
  .pp-article-back {
    padding-top: 32px;
    border-top: 1px solid rgba(80, 30, 21, 0.08);
    margin-bottom: 48px;
  }
  .pp-article-back__link {
    font-family: var(--pp-font);
    font-size: 16px;
    font-weight: 700;
    color: var(--pp-orange);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: gap 0.2s;
  }
  .pp-article-back__link:hover {
    gap: 12px;
  }

  /* === Comments === */
  .pp-article-comments {
    max-width: 800px;
    margin: 0 auto;
    padding-top: 40px;
    border-top: 2px solid rgba(80, 30, 21, 0.06);
  }
  .pp-article-comments__title {
    font-family: var(--pp-font);
    font-size: 24px;
    font-weight: 700;
    color: var(--pp-brown);
    margin-bottom: 24px;
  }
  .pp-article-comments__list {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-bottom: 32px;
  }
  .pp-article-comment {
    display: flex;
    gap: 16px;
    padding: 20px;
    background: var(--pp-cream);
    border-radius: 16px;
  }
  .pp-article-comment__avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--pp-orange);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--pp-font);
    font-weight: 700;
    font-size: 18px;
    flex-shrink: 0;
    text-transform: uppercase;
  }
  .pp-article-comment__body {
    flex: 1;
    min-width: 0;
  }
  .pp-article-comment__header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 8px;
  }
  .pp-article-comment__author {
    font-family: var(--pp-font);
    font-weight: 700;
    font-size: 15px;
    color: var(--pp-brown);
  }
  .pp-article-comment__date {
    font-family: var(--pp-font);
    font-size: 13px;
    color: var(--pp-brown);
    opacity: 0.5;
  }
  .pp-article-comment__content {
    font-family: var(--pp-font);
    font-size: 15px;
    line-height: 1.6;
    color: var(--pp-brown);
  }

  /* === Comment Form === */
  .pp-article-comment-form {
    background: var(--pp-cream);
    border-radius: 20px;
    padding: 32px;
    margin-top: 32px;
  }
  .pp-article-comment-form__title {
    font-family: var(--pp-font);
    font-size: 20px;
    font-weight: 700;
    color: var(--pp-brown);
    margin-bottom: 20px;
  }
  .pp-article-comment-form__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-bottom: 16px;
  }
  .pp-article-comment-form__field {
    margin-bottom: 16px;
  }
  .pp-article-comment-form__row .pp-article-comment-form__field {
    margin-bottom: 0;
  }
  .pp-article-comment-form__label {
    font-family: var(--pp-font);
    font-weight: 600;
    font-size: 14px;
    color: var(--pp-brown);
    margin-bottom: 6px;
    display: block;
  }
  .pp-article-comment-form__input,
  .pp-article-comment-form__textarea {
    width: 100%;
    padding: 12px 16px;
    font-family: var(--pp-font);
    font-size: 15px;
    border: 1.5px solid rgba(80, 30, 21, 0.15);
    border-radius: 12px;
    background: var(--pp-white);
    color: var(--pp-brown);
    transition: border-color 0.2s;
    box-sizing: border-box;
  }
  .pp-article-comment-form__input:focus,
  .pp-article-comment-form__textarea:focus {
    border-color: var(--pp-orange);
    outline: none;
  }
  .pp-article-comment-form__textarea {
    resize: vertical;
    min-height: 120px;
  }
  .pp-article-comment-form__submit {
    font-size: 16px;
    font-weight: 700;
    padding: 12px 32px;
    border-radius: 12px;
  }

  /* === Pagination in comments === */
  .pp-pagination--comments {
    margin-top: 24px;
    margin-bottom: 32px;
  }
  .pp-pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 6px;
    font-family: var(--pp-font);
  }
  .pp-pagination__num {
    width: 42px;
    height: 42px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    font-size: 15px;
    font-weight: 600;
    color: var(--pp-brown);
    text-decoration: none;
    transition: all 0.2s ease;
    background: transparent;
  }
  .pp-pagination__num:hover {
    background: var(--pp-cream);
    color: var(--pp-orange);
  }
  .pp-pagination__num--active {
    background: var(--pp-orange) !important;
    color: #fff !important;
    box-shadow: 0 4px 12px rgba(247, 92, 2, 0.3);
  }
  .pp-pagination__arrow {
    width: 42px;
    height: 42px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    color: var(--pp-brown);
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .pp-pagination__arrow:hover {
    background: var(--pp-cream);
    color: var(--pp-orange);
  }

  /* === Responsive === */
  @media (max-width: 768px) {
    .pp-article-hero { padding: 32px 20px 40px; }
    .pp-article-hero__title { font-size: 26px; }
    .pp-article-section { padding: 24px 16px 60px; }
    .pp-article-body { font-size: 16px; }
    .pp-article-body h2 { font-size: 22px; }
    .pp-article-body h3 { font-size: 19px; }
    .pp-article-featured-img { border-radius: 16px; margin-bottom: 28px; }
    .pp-article-comment { padding: 16px; }
    .pp-article-comment-form { padding: 24px; }
    .pp-article-comment-form__row { grid-template-columns: 1fr; }
    .pp-article-hero .pp-breadcrumb { font-size: 12px; padding: 6px 14px; gap: 6px; flex-wrap: wrap; }
    .pp-article-hero .pp-breadcrumb__item svg { width: 13px; height: 13px; }
    .pp-article-hero .pp-breadcrumb__chevron { width: 12px; height: 12px; }
  }
  @media (max-width: 480px) {
    .pp-article-hero { padding: 24px 16px 32px; }
    .pp-article-hero__title { font-size: 22px; }
    .pp-article-section { padding: 20px 12px 48px; }
    .pp-article-body { font-size: 15px; line-height: 1.75; }
    .pp-article-featured-img { border-radius: 12px; }
    .pp-article-comment-form { padding: 20px; border-radius: 16px; }
    .pp-article-comment { flex-direction: column; gap: 12px; }
    .pp-article-comment__avatar { width: 36px; height: 36px; font-size: 15px; }
  }
</style>

{% schema %}
{
  "name": "Article",
  "settings": []
}
{% endschema %}
