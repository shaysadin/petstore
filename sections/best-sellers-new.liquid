{%- assign collection = collections[section.settings.collection] -%}
{%- assign product_count = section.settings.product_count | default: 4 -%}

<section class="py-5">
  <h2 class="pp-h1 pp-section-heading">{{ section.settings.heading | default: 'המוצרים הנמכרים ביותר:' }}</h2>

  <div class="pp-product-grid">
    {%- if collection != blank -%}
      {%- for product in collection.products limit: product_count -%}
        {% render 'product-card-new', product: product %}
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..product_count) -%}
        <div class="pp-product-card">
          {{ 'product-1' | placeholder_svg_tag: 'pp-product-card__img' }}
          <div class="pp-product-card__body">
            <div class="pp-product-card__info">
              <span class="pp-product-card__title">מוצר לדוגמה</span>
              <div class="pp-product-card__price">
                <span class="pp-product-card__price-current">₪199</span>
                <span class="pp-product-card__price-compare">₪259</span>
              </div>
            </div>
            <div class="pp-product-card__actions">
              <a href="#" class="pp-btn pp-btn--outline">הוספה לסל</a>
            </div>
          </div>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "PP Best Sellers",
  "class": "pp-best-sellers-section",
  "settings": [
    { "type": "text", "id": "heading", "default": "המוצרים הנמכרים ביותר:", "label": "כותרת" },
    { "type": "collection", "id": "collection", "label": "קולקציה" },
    { "type": "range", "id": "product_count", "min": 2, "max": 12, "step": 1, "default": 4, "label": "מספר מוצרים" }
  ],
  "presets": [{ "name": "PP Best Sellers" }]
}
{% endschema %}
