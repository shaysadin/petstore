{%- assign collection = collections[section.settings.collection] -%}
{%- assign product_count = section.settings.product_count | default: 8 -%}

<section class="pp-best-sellers">
  {%- comment -%} Cream curve at TOP, orange is the base. Flat bottom. {%- endcomment -%}
  <div class="pp-best-sellers__cream-top">
    <svg viewBox="0 0 100 100" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M0 0 L100 0 L100 40 C65 45 35 90 0 85 Z" fill="#FFFFFF"/>
    </svg>
  </div>

  <h2 class="pp-h1 pp-section-heading">{{ section.settings.heading | default: 'המוצרים הנמכרים ביותר:' }}</h2>

  <div class="pp-carousel" data-carousel data-direction="rtl">
    <div class="pp-carousel__viewport" data-carousel-viewport>
      <div class="pp-carousel__track" data-carousel-track>
        {%- if collection != blank -%}
          {%- for product in collection.products limit: product_count -%}
            <div class="pp-carousel__slide">
              {% render 'product-card-new', product: product %}
            </div>
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..product_count) -%}
            <div class="pp-carousel__slide">
              <div class="pp-product-card">
                {%- capture prod_img -%}product-{{ i }}.png{%- endcapture -%}
                <img class="pp-product-card__img" src="{{ prod_img | asset_url }}" alt="מוצר לדוגמה {{ i }}" loading="lazy">
                <div class="pp-product-card__body">
                  <div class="pp-product-card__info">
                    <span class="pp-product-card__title">מוצר לדוגמה {{ i }}</span>
                    <p class="pp-product-card__variant">מידה: 45 סמ׳ גובה:4 סמ׳</p>
                    <div class="pp-product-card__price">
                      <span class="pp-product-card__price-current">₪199</span>
                      <span class="pp-product-card__price-compare">₪259</span>
                    </div>
                  </div>
                  <div class="pp-product-card__actions">
                    <div class="pp-qty">
                      <button class="pp-qty__btn pp-qty__plus" type="button" aria-label="הוסף"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="currentColor" d="M19 12.998h-6v6h-2v-6H5v-2h6v-6h2v6h6z"/></svg></button>
                      <span class="pp-qty__count">1</span>
                      <button class="pp-qty__btn pp-qty__minus" type="button" aria-label="הפחת"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="currentColor" d="M5 12.998h14v-2H5z"/></svg></button>
                    </div>
                    <button type="button" class="pp-btn pp-btn--outline" disabled>הוספה לסל</button>
                  </div>
                </div>
              </div>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "PP Best Sellers",
  "class": "pp-best-sellers-section",
  "settings": [
    { "type": "text", "id": "heading", "default": "המוצרים הנמכרים ביותר:", "label": "כותרת" },
    { "type": "collection", "id": "collection", "label": "קולקציה" },
    { "type": "range", "id": "product_count", "min": 2, "max": 12, "step": 1, "default": 8, "label": "מספר מוצרים" }
  ],
  "presets": [{ "name": "PP Best Sellers" }]
}
{% endschema %}
