{% doc %}
  Best selling products grid section. Pulls products from a selected collection.
{% enddoc %}

<section class="space overflow-hidden" id="service-sec">
  <div class="container th-container">
    <div class="row gy-3 justify-content-between align-items-center mb-55">
      <div class="col-xxl-5 col-xl-7 col-md-8">
        <div class="title-area2 mb-1">
          <h2 class="sec-title text-anim mb-1" data-cue="slideInUp">
            <img src="{{ 'shape-home-3-sub-img.png' | asset_url }}" alt="">
            {{ section.settings.heading | default: 'Best Selling Pet Products' }}
          </h2>
        </div>
      </div>
      <div class="col-auto">
        <div class="sec-btn mb-1" data-cue="slideInUp">
          <a class="th-btn style3 th-btn-sm style-border2" href="{{ section.settings.collection.url | default: '/collections/all' }}">{{ section.settings.button_text | default: 'View All Products' }}</a>
        </div>
      </div>
    </div>
    <div class="five-column-grid">
      {%- assign collection = section.settings.collection -%}
      {%- assign product_count = section.settings.product_count | default: 10 -%}
      {%- if collection != blank -%}
        {%- for product in collection.products limit: product_count -%}
          <div data-cue="slideInUp">
            {% render 'product-card', product: product %}
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..product_count) -%}
          <div data-cue="slideInUp">
            <div class="th-product product-grid style-2">
              <div class="product-img">
                {{ 'product-' | append: forloop.index | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
              <div class="product-content">
                <span class="price">$25.00</span>
                <h3 class="product-title"><a href="#">Sample product {{ forloop.index }}</a></h3>
              </div>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Best sellers",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "המוצרים הנמכרים ביותר"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "product_count",
      "label": "Products to show",
      "min": 4,
      "max": 20,
      "step": 1,
      "default": 10
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "צפו בכל המוצרים"
    }
  ],
  "presets": [
    {
      "name": "Best sellers"
    }
  ]
}
{% endschema %}
