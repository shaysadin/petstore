{%- assign brand_images = 'https://images.unsplash.com/photo-1568640347023-a616a30bc3bd?w=1200&h=900&fit=crop&q=80,https://images.unsplash.com/photo-1601758174114-e711c0cbaa69?w=1200&h=900&fit=crop&q=80' | split: ',' -%}

<section class="e-cards-brands full-width has-bg has-bg__brand-1 h-padding__both">
  <div class="e-cards-brands__inner">
    <header class="e-cards-brands__header">
      <h2 class="e-cards-brands__heading h-display-type__three js-anim h-animate-in-slide-up">
        {{ section.settings.heading }}
      </h2>
      {% if section.settings.intro != blank %}
        <p class="e-cards-brands__intro h-display-type__intro js-anim h-animate-in-slide-up">
          {{ section.settings.intro }}
        </p>
      {% endif %}
    </header>

    <div class="e-cards-brands__items">
      {% for block in section.blocks %}
        <article class="e-cards-brands__item" {{ block.shopify_attributes }}>
          <a href="{{ block.settings.link_url | default: '#' }}" class="e-cards-brands__item--inner" aria-label="{{ block.settings.brand_name }}">
            <div class="e-cards-brands__item--media js-anim h-animate-in-fade">
              {% if block.settings.image != blank %}
                {{ block.settings.image | image_url: width: 1600 | image_tag:
                  loading: 'lazy',
                  alt: block.settings.brand_name
                }}
              {% else %}
                <img src="{{ brand_images[forloop.index0] | default: brand_images[0] }}" alt="{{ block.settings.brand_name }}" loading="lazy">
              {% endif %}
            </div>
            <div class="e-cards-brands__item--content js-anim h-animate-in-slide-up">
              <span class="e-btn e-btn--outline">{{ block.settings.brand_name }}</span>
            </div>
          </a>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .e-cards-brands__inner {
    width: 100%;
    margin-right: auto;
    margin-left: auto;
    max-width: var(--standard-container);
    padding-right: var(--spacing);
    padding-left: var(--spacing);
  }

  .e-cards-brands__header {
    margin-bottom: 60px;
    text-align: center;
  }

  .e-cards-brands__heading,
  .e-cards-brands__intro { margin-top: 0; margin-bottom: 0; }
  .e-cards-brands__heading { margin-bottom: 15px; }

  .e-cards-brands__items {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 90px;
  }
  @media (max-width: 1260px) { .e-cards-brands__items { gap: 40px; } }
  @media (max-width: 1060px) { .e-cards-brands__items { gap: 20px; } }
  @media (max-width: 760px) {
    .e-cards-brands__items { grid-template-columns: repeat(1, minmax(0, 1fr)); gap: 50px; }
  }

  .e-cards-brands__item a { text-decoration: none; }

  .e-cards-brands__item--media {
    aspect-ratio: 4/3;
    border-radius: 40px;
    overflow: hidden;
  }
  @media (max-width: 760px) { .e-cards-brands__item--media { border-radius: 30px; } }

  .e-cards-brands__item--media picture,
  .e-cards-brands__item--media img { display: block; width: 100%; height: 100%; max-width: none; }
  .e-cards-brands__item--media img { object-fit: cover; object-position: center; }

  .e-cards-brands__item--content {
    padding-top: 60px;
    display: flex;
    justify-content: center;
  }
  @media (max-width: 1460px) { .e-cards-brands__item--content { padding-top: 50px; } }
  @media (max-width: 1260px) { .e-cards-brands__item--content { padding-top: 40px; } }
  @media (max-width: 1060px) { .e-cards-brands__item--content { padding-top: 30px; } }
  @media (max-width: 760px)  { .e-cards-brands__item--content { padding-top: 20px; } }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.brands_grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Our brands"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "t:labels.intro",
      "default": "We develop, manufacture and manage high volume pet food and treat brands of the finest quality."
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:labels.image"
        },
        {
          "type": "text",
          "id": "brand_name",
          "label": "t:labels.brand_name",
          "default": "Brand name"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "t:labels.link_url"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.brands_grid",
      "blocks": [
        { "type": "brand" },
        { "type": "brand" }
      ]
    }
  ]
}
{% endschema %}
