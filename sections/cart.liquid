{% doc %}
  Cart page with product table, quantity controls, totals, and checkout button.
{% enddoc %}

<div class="breadcumb-wrapper" data-bg-src="{{ 'bg-breadcumb-bg-3.jpg' | asset_url }}">
  <div class="container">
    <div class="breadcumb-content">
      <h1 class="breadcumb-title">עגלת קניות</h1>
      <ul class="breadcumb-menu">
        <li><a href="/">דף הבית</a></li>
        <li>עגלה</li>
      </ul>
    </div>
  </div>
</div>

<section class="space-top space-extra-bottom">
  <div class="container th-container">
    {%- if cart.items.size > 0 -%}
      <form action="{{ routes.cart_url }}" method="post">
        <table class="cart_table">
          <thead>
            <tr>
              <th>תמונה</th>
              <th>שם המוצר</th>
              <th>מחיר</th>
              <th>כמות</th>
              <th>סה״כ</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            {%- for item in cart.items -%}
              <tr>
                <td data-title="תמונה">
                  <a class="cart-productimage" href="{{ item.url }}">
                    {%- if item.image -%}
                      <img src="{{ item.image | image_url: width: 150 }}" alt="{{ item.title | escape }}">
                    {%- endif -%}
                  </a>
                </td>
                <td data-title="שם המוצר">
                  <a class="cart-productname" href="{{ item.url }}">{{ item.product.title }}</a>
                  {%- unless item.variant.title == 'Default Title' -%}
                    <p class="cart-variant">{{ item.variant.title }}</p>
                  {%- endunless -%}
                </td>
                <td data-title="מחיר">
                  <span class="amount">{{ item.price | money }}</span>
                </td>
                <td data-title="כמות">
                  <div class="quantity">
                    <input type="number" class="qty-input" name="updates[]" value="{{ item.quantity }}" min="0" step="1">
                    <button type="button" class="quantity-plus qty-btn"><i class="far fa-chevron-up"></i></button>
                    <button type="button" class="quantity-minus qty-btn"><i class="far fa-chevron-down"></i></button>
                  </div>
                </td>
                <td data-title="סה״כ">
                  <span class="amount">{{ item.line_price | money }}</span>
                </td>
                <td>
                  <a href="/cart/change?line={{ forloop.index }}&quantity=0" class="remove_cart"><i class="fal fa-trash-can"></i></a>
                </td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>

        <div class="row justify-content-between mt-40">
          <div class="col-lg-4 col-md-6">
            <div class="cart-coupon">
              <input class="form-control" type="text" placeholder="קוד קופון...">
              <button type="button" class="th-btn style3">החל</button>
            </div>
          </div>
          <div class="col-md-auto">
            <button type="submit" name="update" class="th-btn style-border2">עדכן עגלה</button>
          </div>
        </div>

        <div class="row justify-content-end mt-40">
          <div class="col-md-5 col-lg-4">
            <h2 class="h4 mb-20">סיכום הזמנה</h2>
            <table class="cart-total-table">
              <tr>
                <th>סה״כ ביניים</th>
                <td>{{ cart.total_price | money }}</td>
              </tr>
              <tr>
                <th>סה״כ</th>
                <td><strong>{{ cart.total_price | money }}</strong></td>
              </tr>
            </table>
            <a href="/checkout" class="th-btn style3 w-100 mt-20">המשך לתשלום</a>
          </div>
        </div>
      </form>
    {%- else -%}
      <div class="text-center py-5">
        <h2>העגלה ריקה</h2>
        <p class="mt-3">נראה שעוד לא הוספת מוצרים לעגלה.</p>
        <a href="/collections/all" class="th-btn style3 mt-4">המשך בקניות</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Cart"
}
{% endschema %}
