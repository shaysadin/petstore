{% doc %}
  Cart page with product list, quantity controls, totals, and checkout button.
{% enddoc %}

<style>
  .pp-cart {
    background: var(--pp-cream);
    min-height: 60vh;
    padding-bottom: 80px;
  }

  .pp-cart__header {
    text-align: center;
    padding: 48px 0 32px;
  }

  .pp-cart__header h1 {
    font-family: var(--pp-font);
    font-size: 2rem;
    font-weight: 700;
    color: var(--pp-brown);
    margin: 0;
  }

  .pp-cart__container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 16px;
  }

  /* ── Empty state ── */
  .pp-cart-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 80px 20px;
    text-align: center;
  }

  .pp-cart-empty__icon {
    font-size: 64px;
    margin-bottom: 20px;
    line-height: 1;
  }

  .pp-cart-empty h2 {
    font-family: var(--pp-font);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--pp-brown);
    margin: 0 0 12px;
  }

  .pp-cart-empty p {
    font-family: var(--pp-font);
    font-size: 1rem;
    color: #7a6a62;
    margin: 0 0 28px;
  }

  .pp-cart-empty .pp-btn {
    display: inline-flex;
  }

  /* ── Item list ── */
  .pp-cart-items {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-bottom: 32px;
  }

  .pp-cart-item {
    display: grid;
    grid-template-columns: 100px 1fr auto auto auto auto;
    gap: 16px;
    align-items: center;
    background: var(--pp-white);
    border-radius: 16px;
    padding: 16px 20px;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
    transition: box-shadow 0.2s;
  }

  .pp-cart-item:hover {
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.12);
  }

  .pp-cart-item__img {
    width: 100px;
    height: 100px;
    border-radius: 12px;
    overflow: hidden;
    flex-shrink: 0;
  }

  .pp-cart-item__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .pp-cart-item__info {
    min-width: 0;
  }

  .pp-cart-item__title {
    font-family: var(--pp-font);
    font-size: 1rem;
    font-weight: 600;
    color: var(--pp-brown);
    text-decoration: none;
    display: block;
    margin-bottom: 4px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .pp-cart-item__title:hover {
    color: var(--pp-orange);
  }

  .pp-cart-item__variant {
    font-family: var(--pp-font);
    font-size: 0.85rem;
    color: #9a8a82;
    margin: 0;
  }

  .pp-cart-item__price {
    font-family: var(--pp-font);
    font-size: 0.95rem;
    color: #7a6a62;
    white-space: nowrap;
  }

  /* ── Quantity selector ── */
  .pp-cart-qty {
    display: inline-flex;
    align-items: center;
    gap: 0;
    background: var(--pp-cream);
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid #e8ddd4;
  }

  .pp-cart-qty__btn {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--pp-brown);
    font-size: 1.1rem;
    font-weight: 600;
    transition: background 0.15s;
  }

  .pp-cart-qty__btn:hover {
    background: rgba(80, 30, 21, 0.08);
  }

  .pp-cart-qty__input {
    width: 40px;
    text-align: center;
    border: none;
    background: none;
    font-family: var(--pp-font);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--pp-brown);
    -moz-appearance: textfield;
    appearance: textfield;
  }

  .pp-cart-qty__input::-webkit-inner-spin-button,
  .pp-cart-qty__input::-webkit-outer-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .pp-cart-item__line-total {
    font-family: var(--pp-font);
    font-size: 1rem;
    font-weight: 700;
    color: var(--pp-brown);
    white-space: nowrap;
    min-width: 80px;
    text-align: center;
  }

  .pp-cart-item__remove {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: none;
    background: none;
    color: #c0a89e;
    cursor: pointer;
    transition: all 0.2s;
    text-decoration: none;
  }

  .pp-cart-item__remove:hover {
    background: #fde8e0;
    color: #e74c3c;
  }

  .pp-cart-item__remove svg {
    width: 18px;
    height: 18px;
  }

  /* ── Cart header row (labels) ── */
  .pp-cart-labels {
    display: grid;
    grid-template-columns: 100px 1fr auto auto auto auto;
    gap: 16px;
    padding: 0 20px 12px;
    font-family: var(--pp-font);
    font-size: 0.85rem;
    font-weight: 600;
    color: #9a8a82;
  }

  .pp-cart-labels span:nth-child(4),
  .pp-cart-labels span:nth-child(5) {
    text-align: center;
  }

  /* ── Actions row ── */
  .pp-cart-actions {
    display: flex;
    justify-content: flex-start;
    margin-bottom: 32px;
  }

  .pp-cart-actions .pp-btn {
    font-size: 0.9rem;
    padding: 10px 24px;
  }

  /* ── Summary ── */
  .pp-cart-summary {
    background: var(--pp-white);
    border-radius: 20px;
    padding: 28px 32px;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
    max-width: 400px;
    margin-inline-start: auto;
  }

  .pp-cart-summary h2 {
    font-family: var(--pp-font);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--pp-brown);
    margin: 0 0 20px;
  }

  .pp-cart-summary__row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 0;
    border-bottom: 1px solid #f0e8e0;
    font-family: var(--pp-font);
    font-size: 0.95rem;
    color: #7a6a62;
  }

  .pp-cart-summary__row:last-of-type {
    border-bottom: none;
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--pp-brown);
    padding-top: 16px;
  }

  .pp-cart-summary__checkout {
    display: block;
    width: 100%;
    padding: 14px 24px;
    margin-top: 20px;
    background: var(--pp-orange);
    color: var(--pp-white);
    font-family: var(--pp-font);
    font-size: 1.05rem;
    font-weight: 700;
    text-align: center;
    text-decoration: none;
    border: none;
    border-radius: 12px;
    cursor: pointer;
    transition: background 0.2s, transform 0.15s;
  }

  .pp-cart-summary__checkout:hover {
    background: var(--pp-brown);
    transform: translateY(-1px);
    color: var(--pp-white);
  }

  /* ── Shared button ── */
  .pp-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px 32px;
    font-family: var(--pp-font);
    font-size: 1rem;
    font-weight: 600;
    border-radius: 12px;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.2s;
    border: none;
  }

  .pp-btn--primary {
    background: var(--pp-orange);
    color: var(--pp-white);
  }

  .pp-btn--primary:hover {
    background: var(--pp-brown);
    color: var(--pp-white);
  }

  .pp-btn--outline {
    background: transparent;
    color: var(--pp-brown);
    border: 2px solid #e0d3c8;
  }

  .pp-btn--outline:hover {
    border-color: var(--pp-brown);
    background: rgba(80, 30, 21, 0.04);
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .pp-cart-labels {
      display: none;
    }

    .pp-cart-item {
      grid-template-columns: 80px 1fr;
      grid-template-rows: auto auto;
      gap: 12px;
      padding: 16px;
    }

    .pp-cart-item__img {
      width: 80px;
      height: 80px;
      grid-row: 1;
      grid-column: 1;
    }

    .pp-cart-item__info {
      grid-row: 1;
      grid-column: 2;
    }

    .pp-cart-item__price,
    .pp-cart-item__line-total {
      display: none;
    }

    .pp-cart-item__mobile-bottom {
      grid-column: 1 / -1;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .pp-cart-item__mobile-total {
      font-family: var(--pp-font);
      font-size: 1rem;
      font-weight: 700;
      color: var(--pp-brown);
    }

    .pp-cart-summary {
      max-width: 100%;
    }

    .pp-cart__header h1 {
      font-size: 1.5rem;
    }
  }

  @media (min-width: 769px) {
    .pp-cart-item__mobile-bottom {
      display: contents;
    }

    .pp-cart-item__mobile-total {
      display: none;
    }
  }
</style>

<section class="pp-cart">
  <div class="pp-cart__header">
    <h1>סל הקניות</h1>
  </div>

  <div class="pp-cart__container">
    {%- if cart.items.size > 0 -%}
      <form action="{{ routes.cart_url }}" method="post">
        <div class="pp-cart-labels" aria-hidden="true">
          <span></span>
          <span>מוצר</span>
          <span>מחיר</span>
          <span>כמות</span>
          <span>סה״כ</span>
          <span></span>
        </div>

        <div class="pp-cart-items">
          {%- for item in cart.items -%}
            <div class="pp-cart-item">
              <a href="{{ item.url }}" class="pp-cart-item__img">
                {%- if item.image -%}
                  <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title | escape }}" loading="lazy">
                {%- endif -%}
              </a>

              <div class="pp-cart-item__info">
                <a href="{{ item.url }}" class="pp-cart-item__title">{{ item.product.title }}</a>
                {%- unless item.variant.title == 'Default Title' -%}
                  <p class="pp-cart-item__variant">{{ item.variant.title }}</p>
                {%- endunless -%}
              </div>

              <div class="pp-cart-item__mobile-bottom">
                <span class="pp-cart-item__price">{{ item.price | money }}</span>

                <div class="pp-cart-qty">
                  <button type="button" class="pp-cart-qty__btn" onclick="this.parentNode.querySelector('input').stepUp();this.closest('form').querySelector('[name=update]').click();" aria-label="הוסף">+</button>
                  <input type="number" class="pp-cart-qty__input" name="updates[]" value="{{ item.quantity }}" min="0" step="1" aria-label="כמות">
                  <button type="button" class="pp-cart-qty__btn" onclick="this.parentNode.querySelector('input').stepDown();this.closest('form').querySelector('[name=update]').click();" aria-label="הפחת">−</button>
                </div>

                <span class="pp-cart-item__line-total">{{ item.line_price | money }}</span>
                <span class="pp-cart-item__mobile-total">{{ item.line_price | money }}</span>

                <a href="/cart/change?line={{ forloop.index }}&quantity=0" class="pp-cart-item__remove" aria-label="הסר מוצר">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="3 6 5 6 21 6"></polyline>
                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                  </svg>
                </a>
              </div>
            </div>
          {%- endfor -%}
        </div>

        <div class="pp-cart-actions">
          <button type="submit" name="update" class="pp-btn pp-btn--outline">עדכן סל</button>
        </div>

        <div class="pp-cart-summary">
          <h2>סיכום הזמנה</h2>
          <div class="pp-cart-summary__row">
            <span>סה״כ ביניים</span>
            <span>{{ cart.total_price | money }}</span>
          </div>
          <div class="pp-cart-summary__row">
            <span>סה״כ</span>
            <span>{{ cart.total_price | money }}</span>
          </div>
          <a href="/checkout" class="pp-cart-summary__checkout">המשך לתשלום</a>
        </div>
      </form>
    {%- else -%}
      <div class="pp-cart-empty">
        <div class="pp-cart-empty__icon">🐾</div>
        <h2>הסל ריק</h2>
        <p>נראה שעוד לא הוספת מוצרים לסל.</p>
        <a href="/collections/all" class="pp-btn pp-btn--primary">המשך לקנות</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Cart"
}
{% endschema %}
