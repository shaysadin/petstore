<section class="pp-category-section">
  {%- comment -%} Brown wave section with heading {%- endcomment -%}
  <div class="pp-category-wave">
    <svg style="position:absolute;top:-1px;left:0;width:100%;height:250px;display:block;" viewBox="0 0 1920 250" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M0 200C480 200 720 20 960 60C1200 100 1440 180 1920 200V0H0Z" fill="#FFFFFF"/>
    </svg>
    <h2 class="pp-category-wave__heading">{{ section.settings.heading | default: 'חפשו מוצר לפי:' }}</h2>
  </div>

  {%- comment -%} Category cards {%- endcomment -%}
  <div class="pp-category-grid">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.link | default: '#' }}" class="pp-category-card" {{ block.shopify_attributes }}>
        <div class="pp-category-card__top">
          {%- if block.settings.image -%}
            <img src="{{ block.settings.image | image_url: width: 530 }}" alt="{{ block.settings.title | escape }}" loading="lazy">
          {%- else -%}
            {%- assign cat_index = forloop.index -%}
            {%- if cat_index > 4 -%}{%- assign cat_index = 1 -%}{%- endif -%}
            {%- capture cat_img -%}cat-3d-{{ cat_index }}.png{%- endcapture -%}
            <img src="{{ cat_img | asset_url }}" alt="{{ block.settings.title | escape }}" loading="lazy">
          {%- endif -%}
        </div>
        <div class="pp-category-card__bottom"></div>
        <span class="pp-category-card__label">{{ block.settings.title }}</span>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "PP Category Search",
  "class": "pp-category-search-section",
  "settings": [
    { "type": "text", "id": "heading", "default": "חפשו מוצר לפי:", "label": "כותרת" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "קטגוריה",
      "settings": [
        { "type": "text", "id": "title", "label": "שם קטגוריה" },
        { "type": "image_picker", "id": "image", "label": "אייקון קטגוריה" },
        { "type": "url", "id": "link", "label": "קישור" }
      ]
    }
  ],
  "presets": [
    {
      "name": "PP Category Search",
      "blocks": [
        { "type": "category", "settings": { "title": "מזון לבעלי חיים" } },
        { "type": "category", "settings": { "title": "חטיפים" } },
        { "type": "category", "settings": { "title": "צעצועים" } },
        { "type": "category", "settings": { "title": "מוצרי טיפוח" } },
        { "type": "category", "settings": { "title": "מיטות" } }
      ]
    }
  ]
}
{% endschema %}
