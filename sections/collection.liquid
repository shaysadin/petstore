{%- assign products_per_page = section.settings.products_per_page | default: 20 -%}

<div class="pp-collection-hero">
  <div class="pp-collection-hero__inner">
    <nav class="pp-breadcrumb" aria-label="ניווט">
      <a href="/" class="pp-breadcrumb__item">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        דף הבית
      </a>
      <svg class="pp-breadcrumb__chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M15 18L9 12L15 6"/></svg>
      <span class="pp-breadcrumb__item pp-breadcrumb__item--current">{{ collection.title }}</span>
    </nav>
    <h1 class="pp-collection-hero__title">{{ collection.title }}</h1>
    {%- if collection.description != blank -%}
      <p class="pp-collection-hero__desc">{{ collection.description | strip_html | truncate: 200 }}</p>
    {%- endif -%}
  </div>
  <div class="pp-collection-hero__paw">🐾</div>
</div>

{% paginate collection.products by products_per_page %}
<section class="pp-collection-section">
  <div class="pp-collection-toolbar">
    <p class="pp-collection-toolbar__count">
      <span class="pp-collection-toolbar__count-num">{{ collection.products_count }}</span> מוצרים
    </p>
    <div class="pp-collection-toolbar__actions">
      <form class="pp-collection-toolbar__sort">
        <label class="pp-collection-toolbar__sort-label">מיון:</label>
        <select name="sort_by" onchange="window.location.href=this.value">
          {%- for option in collection.sort_options -%}
            <option value="{{ option.url }}"{% if collection.sort_by == option.value %} selected{% endif %}>{{ option.name }}</option>
          {%- endfor -%}
        </select>
      </form>
    </div>
  </div>

  <div class="pp-collection-grid">
    {%- for product in collection.products -%}
      <div class="pp-collection-grid__item" style="animation-delay: {{ forloop.index0 | times: 60 }}ms">
        {% render 'product-card-new', product: product %}
      </div>
    {%- else -%}
      <div class="pp-collection-grid__empty">
        <div class="pp-collection-grid__empty-icon">🔍</div>
        <p class="pp-collection-grid__empty-text">לא נמצאו מוצרים בקולקציה זו.</p>
        <a href="/collections/all" class="pp-btn pp-btn--primary">לכל המוצרים</a>
      </div>
    {%- endfor -%}
  </div>

  {%- if paginate.pages > 1 -%}
    <div class="pp-pagination">
      {%- if paginate.previous -%}
        <a href="{{ paginate.previous.url }}" class="pp-pagination__arrow pp-pagination__arrow--next" aria-label="עמוד קודם">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      {%- endif -%}
      {%- for part in paginate.parts -%}
        {%- if part.is_link -%}
          <a href="{{ part.url }}" class="pp-pagination__num">{{ part.title }}</a>
        {%- else -%}
          <span class="pp-pagination__num pp-pagination__num--active">{{ part.title }}</span>
        {%- endif -%}
      {%- endfor -%}
      {%- if paginate.next -%}
        <a href="{{ paginate.next.url }}" class="pp-pagination__arrow pp-pagination__arrow--prev" aria-label="עמוד הבא">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      {%- endif -%}
    </div>
  {%- endif -%}
</section>
{% endpaginate %}

<style>
  /* === Collection Hero === */
  .pp-collection-hero {
    background: var(--pp-brown);
    padding: 48px 40px 56px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .pp-collection-hero__inner {
    position: relative;
    z-index: 1;
    max-width: 800px;
    margin: 0 auto;
  }
  .pp-collection-hero__title {
    font-family: var(--pp-font);
    font-weight: 800;
    font-size: clamp(32px, 5vw, 52px);
    color: var(--pp-orange);
    margin: 12px 0 14px;
    line-height: 1.15;
  }
  .pp-collection-hero__desc {
    font-family: var(--pp-font);
    font-size: 16px;
    color: var(--pp-cream);
    opacity: 0.85;
    max-width: 560px;
    margin: 0 auto;
    line-height: 1.6;
  }
  .pp-collection-hero__paw {
    position: absolute;
    bottom: -20px;
    left: 10%;
    font-size: 120px;
    opacity: 0.06;
    transform: rotate(-15deg);
    pointer-events: none;
  }

  /* === Breadcrumb === */
  .pp-breadcrumb {
    font-family: var(--pp-font);
    font-size: 13px;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 247, 236, 0.12);
    border: 1px solid rgba(255, 247, 236, 0.15);
    backdrop-filter: blur(6px);
    border-radius: 50px;
    padding: 8px 20px;
    margin-bottom: 4px;
  }
  .pp-breadcrumb__item {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--pp-cream);
    text-decoration: none;
    opacity: 0.75;
    transition: opacity 0.2s ease;
  }
  a.pp-breadcrumb__item:hover {
    opacity: 1;
  }
  .pp-breadcrumb__item--current {
    color: var(--pp-orange);
    opacity: 1;
    font-weight: 700;
  }
  .pp-breadcrumb__chevron {
    color: var(--pp-cream);
    opacity: 0.4;
    flex-shrink: 0;
  }

  /* === Collection Section === */
  .pp-collection-section {
    max-width: 1440px;
    margin: 0 auto;
    padding: 36px 40px 80px;
    background: var(--pp-white);
  }

  /* === Toolbar === */
  .pp-collection-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 28px;
    padding-bottom: 20px;
    border-bottom: 1px solid rgba(80, 30, 21, 0.08);
    font-family: var(--pp-font);
  }
  .pp-collection-toolbar__count {
    font-size: 15px;
    color: var(--pp-brown);
    font-weight: 500;
  }
  .pp-collection-toolbar__count-num {
    font-weight: 700;
    color: var(--pp-orange);
    font-size: 18px;
  }
  .pp-collection-toolbar__actions {
    display: flex;
    gap: 12px;
    align-items: center;
  }
  .pp-collection-toolbar__sort {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .pp-collection-toolbar__sort-label {
    font-size: 14px;
    color: var(--pp-brown);
    font-weight: 600;
  }
  .pp-collection-toolbar__sort select {
    font-family: var(--pp-font);
    font-size: 14px;
    padding: 10px 16px;
    border: 1.5px solid rgba(80, 30, 21, 0.15);
    border-radius: 12px;
    background: var(--pp-cream);
    color: var(--pp-brown);
    cursor: pointer;
    transition: border-color 0.2s;
    -webkit-appearance: none;
    appearance: none;
    background-image: url("data:image/svg+xml,%3Csvg width='12' height='8' viewBox='0 0 12 8' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1.5L6 6.5L11 1.5' stroke='%23501E15' stroke-width='2' stroke-linecap='round'/%3E%3C/svg%3E");
    background-repeat: no-repeat;
    background-position: 12px center;
    padding-left: 32px;
  }
  .pp-collection-toolbar__sort select:hover,
  .pp-collection-toolbar__sort select:focus {
    border-color: var(--pp-orange);
    outline: none;
  }

  /* === Product Grid === */
  .pp-collection-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 28px;
  }
  .pp-collection-grid__item {
    animation: ppFadeInUp 0.5s ease both;
  }
  .pp-collection-grid__item .pp-product-card {
    width: 100% !important;
    height: 100%;
    min-height: 0;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .pp-collection-grid__item .pp-product-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 28px rgba(80, 30, 21, 0.12) !important;
  }

  /* === Empty State === */
  .pp-collection-grid__empty {
    grid-column: 1 / -1;
    text-align: center;
    padding: 80px 20px;
  }
  .pp-collection-grid__empty-icon {
    font-size: 64px;
    margin-bottom: 20px;
  }
  .pp-collection-grid__empty-text {
    font-family: var(--pp-font);
    font-size: 18px;
    color: var(--pp-brown);
    margin-bottom: 24px;
  }

  /* === Pagination === */
  .pp-pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 6px;
    margin-top: 56px;
    font-family: var(--pp-font);
  }
  .pp-pagination__num {
    width: 42px;
    height: 42px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    font-size: 15px;
    font-weight: 600;
    color: var(--pp-brown);
    text-decoration: none;
    transition: all 0.2s ease;
    background: transparent;
  }
  .pp-pagination__num:hover {
    background: var(--pp-cream);
    color: var(--pp-orange);
  }
  .pp-pagination__num--active {
    background: var(--pp-orange) !important;
    color: #fff !important;
    box-shadow: 0 4px 12px rgba(247, 92, 2, 0.3);
  }
  .pp-pagination__arrow {
    width: 42px;
    height: 42px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    color: var(--pp-brown);
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .pp-pagination__arrow:hover {
    background: var(--pp-cream);
    color: var(--pp-orange);
  }

  /* === Animation === */
  @keyframes ppFadeInUp {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* === Responsive === */
  @media (max-width: 1200px) {
    .pp-collection-grid { grid-template-columns: repeat(3, 1fr); gap: 24px; }
  }
  @media (max-width: 768px) {
    .pp-collection-hero { padding: 32px 20px 40px; }
    .pp-collection-hero__title { font-size: 32px; }
    .pp-collection-hero__paw { font-size: 80px; bottom: -10px; }
    .pp-collection-section { padding: 24px 16px 60px; }
    .pp-collection-grid { grid-template-columns: repeat(2, 1fr); gap: 14px; }
    .pp-collection-grid__item .pp-product-card { min-height: auto !important; }
    .pp-collection-toolbar { flex-direction: column; gap: 12px; align-items: flex-end; }
    .pp-collection-toolbar__count { align-self: flex-end; }
    .pp-breadcrumb { font-size: 12px; padding: 6px 14px; gap: 6px; }
    .pp-breadcrumb__item svg { width: 13px; height: 13px; }
    .pp-breadcrumb__chevron { width: 12px; height: 12px; }
  }
  @media (max-width: 480px) {
    .pp-collection-hero { padding: 24px 16px 32px; }
    .pp-collection-hero__title { font-size: 28px; }
    .pp-collection-grid { gap: 12px; }
    .pp-collection-section { padding: 20px 12px 48px; }
    .pp-pagination__num, .pp-pagination__arrow { width: 36px; height: 36px; font-size: 14px; border-radius: 10px; }
  }
</style>

{% schema %}
{
  "name": "Collection",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "label": "מוצרים בעמוד",
      "min": 8,
      "max": 40,
      "step": 4,
      "default": 20
    }
  ]
}
{% endschema %}
