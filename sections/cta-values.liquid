<section class="e-cta full-width">
  <div class="e-cta__inner">
    <div class="e-cta__content">
      <header class="e-cta__header">
        <h2 class="e-cta__heading h-display-type__two js-anim h-animate-in-slide-up">
          {{ section.settings.heading }}
        </h2>
      </header>
      {% if section.settings.intro != blank %}
        <div class="e-cta__message h-display-type__intro js-anim h-animate-in-slide-up">
          {{ section.settings.intro }}
        </div>
      {% endif %}
      {% if section.settings.link_text != blank %}
        <div class="e-cta__link js-anim h-animate-in-slide-up">
          <a href="{{ section.settings.link_url | default: '#' }}" aria-label="{{ section.settings.link_text }}">
            <span>{{ section.settings.link_text }}</span>
            {% render 'arrow-icon', class: 'e-cta__link--arrow js-anim h-animate-in-fade' %}
          </a>
        </div>
      {% endif %}
    </div>

    <div class="e-cta__media">
      {% if section.settings.main_image != blank %}
        {{ section.settings.main_image | image_url: width: 1000 | image_tag:
          loading: 'lazy',
          alt: section.settings.heading
        }}
      {% else %}
        <img src="https://images.unsplash.com/photo-1587300003388-59208cc962cb?w=1000&h=1200&fit=crop&q=80" alt="{{ section.settings.heading }}" loading="lazy">
      {% endif %}

      <div class="e-cta__overlay-icon js-anim h-animate-in-fade">
        {% if section.settings.overlay_icon != blank %}
          {{ section.settings.overlay_icon | image_url: width: 322 | image_tag:
            loading: 'lazy',
            alt: ''
          }}
        {% else %}
          <img src="https://images.unsplash.com/photo-1560807707-8cc77767d783?w=322&h=322&fit=crop&q=80" alt="" loading="lazy">
        {% endif %}
      </div>

      {% if section.settings.overlay_title != blank %}
        <header class="e-cta__overlay-title__header js-anim h-animate-in-fade">
          <h3 class="e-cta__overlay-title__heading">{{ section.settings.overlay_title }}</h3>
        </header>
      {% endif %}
    </div>
  </div>

  <div class="e-cta__bg">
    {% if section.settings.background_image != blank %}
      {{ section.settings.background_image | image_url: width: 1920 | image_tag:
        loading: 'lazy',
        alt: ''
      }}
    {% else %}
      <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=1920&h=1080&fit=crop&q=80" alt="" loading="lazy">
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .e-cta {
    padding-top: 100px;
    padding-bottom: 100px;
    position: relative;
  }
  @media (max-width: 760px) { .e-cta { padding: 0; } }

  .e-cta__inner {
    width: 100%;
    margin-right: auto;
    margin-left: auto;
    max-width: calc(var(--standard-container) - var(--spacing) * 2);
    padding-left: 0;
    padding-right: 0;
    position: relative;
    z-index: 2;
    background-color: #fff;
    border-radius: 40px;
    display: flex;
    overflow: hidden;
  }
  @media (max-width: 760px) {
    .e-cta__inner { flex-direction: column-reverse; border-radius: 0; }
  }

  .e-cta__heading { line-height: 1; margin-top: 0; }

  .e-cta__content {
    width: 50%;
    padding: 80px 120px 80px 80px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
  }
  @media (max-width: 1260px) { .e-cta__content { padding: 60px 80px 60px 60px; } }
  @media (max-width: 760px) {
    .e-cta__content {
      width: 100%;
      align-items: center;
      text-align: center;
      padding: 30px 20px;
    }
  }

  .e-cta__media picture,
  .e-cta__media img,
  .e-cta__bg picture,
  .e-cta__bg img,
  .e-cta__overlay-icon picture,
  .e-cta__overlay-icon img {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
  }
  .e-cta__media img,
  .e-cta__bg img { object-fit: cover; object-position: center; }

  .e-cta__media {
    position: relative;
    overflow: hidden;
    width: 50%;
  }
  @media (max-width: 760px) { .e-cta__media { width: 100%; aspect-ratio: 3/4; } }

  .e-cta__bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }
  @media (max-width: 760px) { .e-cta__bg { display: none; } }

  .e-cta__overlay-icon {
    position: absolute;
    z-index: 3;
    top: 40px;
    right: 40px;
    width: 160px;
    height: 160px;
    border-radius: 50%;
    overflow: hidden;
  }
  @media (max-width: 1260px) { .e-cta__overlay-icon { top: 30px; right: 30px; width: 120px; height: 120px; } }
  @media (max-width: 760px)  { .e-cta__overlay-icon { top: 20px; right: 20px; width: 90px; height: 90px; } }
  .e-cta__overlay-icon img { object-fit: contain; }

  .e-cta__overlay-title__header {
    text-align: center;
    position: absolute;
    z-index: 4;
    left: 0;
    right: 0;
    bottom: 20px;
    width: 100%;
    max-width: 560px;
    margin-left: auto;
    margin-right: auto;
    padding-left: var(--spacing);
    padding-right: var(--spacing);
  }

  .e-cta__overlay-title__heading {
    margin-top: 0;
    margin-bottom: 0;
    color: #fff;
    font-family: var(--secondary-font);
    line-height: 0.8;
    font-size: clamp(70px, 4.375rem + (1vw - 3.2px) * 6.0976, 170px);
  }

  .e-cta__link span {
    text-transform: uppercase;
    font-size: 22px;
    font-weight: 700;
    display: inline-block;
    margin-right: 8px;
    width: auto;
    flex: 0;
    transition: opacity 0.2s 0.2s ease-in-out, flex 0.2s ease-in-out;
    overflow: hidden;
    opacity: 0;
  }
  @media (max-width: 1260px) { .e-cta__link span { flex: 1; opacity: 1; font-size: 20px; } }
  @media (max-width: 760px)  { .e-cta__link span { font-size: 18px; } }

  .e-cta__link a {
    text-decoration: none;
    display: inline-flex;
    align-items: center;
  }
  .e-cta__link:hover span { width: auto; opacity: 1; flex: 1; }

  .e-cta__link--arrow { fill: #000; width: 60px; height: 45px; }
  @media (max-width: 1260px) { .e-cta__link--arrow { width: 50px; height: 35px; } }
  @media (max-width: 760px)  { .e-cta__link--arrow { width: 40px; height: 30px; } }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.cta_values",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Our values"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "t:labels.intro"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "t:labels.link_text",
      "default": "Values"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "t:labels.link_url"
    },
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "t:labels.image"
    },
    {
      "type": "image_picker",
      "id": "overlay_icon",
      "label": "t:labels.overlay_icon"
    },
    {
      "type": "text",
      "id": "overlay_title",
      "label": "t:labels.overlay_title",
      "default": "From field to bowl"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:labels.background_image"
    }
  ],
  "presets": [
    {
      "name": "t:general.cta_values"
    }
  ]
}
{% endschema %}
