{%- assign collection = collections[section.settings.collection] -%}
{%- assign product_count = section.settings.product_count | default: 4 -%}

<section>
  {%- if section.settings.heading != blank -%}
    <h2 class="pp-h1 pp-section-heading">{{ section.settings.heading }}</h2>
  {%- endif -%}

  <div class="pp-product-grid">
    {%- if collection != blank -%}
      {%- for product in collection.products limit: product_count -%}
        {% render 'product-card-new', product: product %}
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..product_count) -%}
        <div class="pp-product-card">
          {%- assign food_idx = i | plus: 4 -%}
          {%- if food_idx > 8 -%}{%- assign food_idx = food_idx | minus: 8 | plus: 4 -%}{%- endif -%}
          {%- capture food_img -%}product-{{ food_idx }}.png{%- endcapture -%}
          <img class="pp-product-card__img" src="{{ food_img | asset_url }}" alt="מוצר לדוגמה" loading="lazy">
          <div class="pp-product-card__body">
            <div class="pp-product-card__info">
              <span class="pp-product-card__title">מוצר לדוגמה</span>
              <p class="pp-product-card__variant">מידה: 45 סמ׳ גובה:4 סמ׳</p>
              <div class="pp-product-card__price">
                <span class="pp-product-card__price-current">₪199</span>
                <span class="pp-product-card__price-compare">₪259</span>
              </div>
            </div>
            <div class="pp-product-card__actions">
              <a href="#" class="pp-btn pp-btn--outline">הוספה לסל</a>
              <div class="pp-qty">
                <button class="pp-qty__btn" type="button" aria-label="הוסף"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="currentColor" d="M19 12.998h-6v6h-2v-6H5v-2h6v-6h2v6h6z"/></svg></button>
                <span class="pp-qty__count">1</span>
                <button class="pp-qty__btn" type="button" aria-label="הפחת"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="currentColor" d="M5 12.998h14v-2H5z"/></svg></button>
              </div>
            </div>
          </div>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "PP Food Products",
  "class": "pp-food-products-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "כותרת" },
    { "type": "collection", "id": "collection", "label": "קולקציה" },
    { "type": "range", "id": "product_count", "min": 2, "max": 12, "step": 1, "default": 4, "label": "מספר מוצרים" }
  ],
  "presets": [{ "name": "PP Food Products" }]
}
{% endschema %}
