<style>
  .pp-header-section .shopify-section-header-group { display: contents; }
  .pp-navbar__cart-count {
    position: absolute;
    top: -6px;
    right: -6px;
    background: var(--pp-brown);
    color: var(--pp-cream);
    font-family: var(--pp-font);
    font-size: 11px;
    font-weight: 700;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }
  .pp-navbar__cart-count:empty,
  .pp-navbar__cart-count[data-count="0"] { display: none; }
</style>
<header class="pp-navbar" data-section-id="{{ section.id }}">
  <div style="display:flex;align-items:center;justify-content:space-between;width:100%;max-width:1920px;margin:0 auto;padding:0 34px;">
    {%- comment -%} Logo (right side in RTL) {%- endcomment -%}
    <div class="pp-navbar__logo-wrap">
      <a href="{{ routes.root_url }}" style="text-decoration:none;">
        {%- if section.settings.logo -%}
          <img class="pp-navbar__logo" src="{{ section.settings.logo | image_url: width: 424 }}" alt="{{ shop.name }}" width="212" height="21">
        {%- else -%}
          <span class="pp-navbar__logo-text">Pets Paradise</span>
        {%- endif -%}
      </a>
    </div>

    {%- comment -%} Nav links (center) {%- endcomment -%}
    {%- assign nav_menu = linklists[section.settings.menu] -%}
    <nav class="pp-navbar__nav d-none d-lg-flex">
      {%- if nav_menu.links.size > 0 -%}
        {%- for link in nav_menu.links -%}
          <div class="pp-navbar__nav-item">
            <a href="{{ link.url }}" class="pp-nav-link" title="{{ link.title }}">{{ link.title | truncate: 20, '...' }}</a>
          </div>
        {%- endfor -%}
      {%- else -%}
        <div class="pp-navbar__nav-item"><a href="/collections/כלבים" class="pp-nav-link">כלבים</a></div>
        <div class="pp-navbar__nav-item"><a href="/collections/חתולים" class="pp-nav-link">חתולים</a></div>
        <div class="pp-navbar__nav-item"><a href="/collections/מזון-יבש" class="pp-nav-link">מזון</a></div>
        <div class="pp-navbar__nav-item"><a href="/collections/חטיפים" class="pp-nav-link">חטיפים</a></div>
        <div class="pp-navbar__nav-item"><a href="/collections/צעצועים" class="pp-nav-link">צעצועים</a></div>
        <div class="pp-navbar__nav-item"><a href="/collections/מיטות" class="pp-nav-link">מיטות</a></div>
        <div class="pp-navbar__nav-item"><a href="/collections/מוצרי-טיפוח" class="pp-nav-link">טיפוח</a></div>
        <div class="pp-navbar__nav-item"><a href="/collections/מבצעים" class="pp-nav-link">מבצעים</a></div>
      {%- endif -%}
    </nav>

    <div style="display:flex;align-items:center;gap:16px;">
      {%- comment -%} Search bar {%- endcomment -%}
      <form action="{{ routes.search_url }}" method="get" class="pp-navbar__search d-none d-md-flex">
        <input type="text" name="q" placeholder="{{ section.settings.search_placeholder | default: 'חיפוש מוצר' }}" autocomplete="off">
        <button type="submit" style="background:none;border:none;cursor:pointer;padding:0;display:flex;align-items:center;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M21 21L15 15M17 10C17 13.866 13.866 17 10 17C6.13401 17 3 13.866 3 10C3 6.13401 6.13401 3 10 3C13.866 3 17 6.13401 17 10Z" stroke="rgba(0,0,0,0.4)" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </button>
      </form>

      {%- comment -%} Cart + Wishlist icons {%- endcomment -%}
      <div class="pp-navbar__icons">
        <a href="{{ routes.cart_url }}" class="pp-navbar__icon" aria-label="עגלת קניות" style="position:relative;">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none"><path d="M6 2L3 6V20C3 20.5304 3.21071 21.0391 3.58579 21.4142C3.96086 21.7893 4.46957 22 5 22H19C19.5304 22 20.0391 21.7893 20.4142 21.4142C20.7893 21.0391 21 20.5304 21 20V6L18 2H6Z" stroke="#FFFFFF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M3 6H21" stroke="#FFFFFF" stroke-width="1.5"/><path d="M16 10C16 11.0609 15.5786 12.0783 14.8284 12.8284C14.0783 13.5786 13.0609 14 12 14C10.9391 14 9.92172 13.5786 9.17157 12.8284C8.42143 12.0783 8 11.0609 8 10" stroke="#FFFFFF" stroke-width="1.5" stroke-linecap="round"/></svg>
          <span class="pp-navbar__cart-count" id="ppCartCount" data-count="{{ cart.item_count }}">{{ cart.item_count }}</span>
        </a>
        <a href="/pages/wishlist" class="pp-navbar__icon" aria-label="מועדפים">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none"><path d="M20.84 4.61C20.3292 4.099 19.7228 3.69365 19.0554 3.41708C18.3879 3.14052 17.6725 2.99817 16.95 2.99817C16.2275 2.99817 15.5121 3.14052 14.8446 3.41708C14.1772 3.69365 13.5708 4.099 13.06 4.61L12 5.67L10.94 4.61C9.9083 3.57831 8.50903 2.99871 7.05 2.99871C5.59096 2.99871 4.19169 3.57831 3.16 4.61C2.1283 5.64169 1.54871 7.04097 1.54871 8.5C1.54871 9.95903 2.1283 11.3583 3.16 12.39L12 21.23L20.84 12.39C21.351 11.8792 21.7563 11.2728 22.0329 10.6054C22.3095 9.93789 22.4518 9.22249 22.4518 8.5C22.4518 7.77751 22.3095 7.0621 22.0329 6.39464C21.7563 5.72718 21.351 5.12075 20.84 4.61Z" stroke="#FFFFFF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>

      {%- comment -%} Mobile hamburger {%- endcomment -%}
      <button class="d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#ppMobileMenu" aria-label="תפריט" style="background:none;border:none;padding:0;cursor:pointer;">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none"><path d="M3 12H21M3 6H21M3 18H21" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round"/></svg>
      </button>
    </div>
  </div>
</header>

{%- comment -%} Mobile offcanvas menu {%- endcomment -%}
<div class="offcanvas offcanvas-end" tabindex="-1" id="ppMobileMenu" style="z-index:9999;">
  <div class="offcanvas-header">
    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="סגור"></button>
  </div>
  <div class="offcanvas-body" style="direction:rtl;">
    <nav style="display:flex;flex-direction:column;gap:16px;">
      {%- if nav_menu.links.size > 0 -%}
        {%- for link in nav_menu.links -%}
          <a href="{{ link.url }}" class="pp-nav-link" style="font-size:18px;color:var(--pp-brown);">{{ link.title }}</a>
        {%- endfor -%}
      {%- else -%}
        <a href="/collections/כלבים" class="pp-nav-link" style="font-size:18px;color:var(--pp-brown);">כלבים</a>
        <a href="/collections/חתולים" class="pp-nav-link" style="font-size:18px;color:var(--pp-brown);">חתולים</a>
        <a href="/collections/מזון-יבש" class="pp-nav-link" style="font-size:18px;color:var(--pp-brown);">מזון</a>
        <a href="/collections/חטיפים" class="pp-nav-link" style="font-size:18px;color:var(--pp-brown);">חטיפים</a>
        <a href="/collections/צעצועים" class="pp-nav-link" style="font-size:18px;color:var(--pp-brown);">צעצועים</a>
        <a href="/collections/מיטות" class="pp-nav-link" style="font-size:18px;color:var(--pp-brown);">מיטות</a>
        <a href="/collections/מוצרי-טיפוח" class="pp-nav-link" style="font-size:18px;color:var(--pp-brown);">טיפוח</a>
        <a href="/collections/מבצעים" class="pp-nav-link" style="font-size:18px;color:var(--pp-brown);">מבצעים</a>
      {%- endif -%}
    </nav>
    <form action="{{ routes.search_url }}" method="get" class="pp-navbar__search" style="margin-top:24px;width:100%;">
      <input type="text" name="q" placeholder="{{ section.settings.search_placeholder | default: 'חיפוש מוצר' }}" autocomplete="off">
      <button type="submit" style="background:none;border:none;cursor:pointer;padding:0;display:flex;align-items:center;">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M21 21L15 15M17 10C17 13.866 13.866 17 10 17C6.13401 17 3 13.866 3 10C3 6.13401 6.13401 3 10 3C13.866 3 17 6.13401 17 10Z" stroke="rgba(0,0,0,0.4)" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </button>
    </form>
    <div style="margin-top:24px;display:flex;gap:16px;">
      <a href="{{ routes.cart_url }}" style="color:var(--pp-brown);font-family:var(--pp-font);font-weight:700;font-size:18px;text-decoration:none;">
        עגלת קניות (<span class="pp-mobile-cart-count">{{ cart.item_count }}</span>)
      </a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "PP Header",
  "class": "pp-header-section",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "לוגו" },
    { "type": "link_list", "id": "menu", "default": "main-menu", "label": "תפריט ניווט" },
    { "type": "text", "id": "search_placeholder", "default": "חיפוש מוצר", "label": "טקסט חיפוש" }
  ]
}
{% endschema %}
