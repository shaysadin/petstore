<div class="pp-cart-sidebar-overlay" id="ppCartSidebarOverlay"></div>

{%- comment -%} Cart Sidebar {%- endcomment -%}
<div class="pp-cart-sidebar" id="ppCartSidebar">
  <div class="pp-cart-sidebar__header">
    <h2 class="pp-cart-sidebar__title">סל הקניות</h2>
    <button class="pp-cart-sidebar__close" id="ppCartSidebarClose" aria-label="סגור">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M18 6L6 18M6 6L18 18" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>
    </button>
  </div>
  <div class="pp-cart-sidebar__items" id="ppCartSidebarItems"></div>
  <div class="pp-cart-sidebar__footer" id="ppCartSidebarFooter" style="display:none;">
    <div class="pp-cart-sidebar__subtotal">
      <span class="pp-cart-sidebar__subtotal-label">סה״כ</span>
      <span class="pp-cart-sidebar__subtotal-value" id="ppCartSidebarSubtotal"></span>
    </div>
    <a href="/checkout" class="pp-cart-sidebar__checkout">המשך לתשלום</a>
    <a href="/cart" class="pp-cart-sidebar__view-cart">צפה בסל</a>
  </div>
</div>

<script>
  (function() {
    /* ====== Mobile Menu Sidebar ====== */
    var openBtn = document.getElementById('ppSidebarOpen');
    var closeBtn = document.getElementById('ppSidebarClose');
    var overlay = document.getElementById('ppSidebarOverlay');
    var sidebar = document.getElementById('ppSidebar');

    function openSidebar() {
      sidebar.classList.add('active');
      overlay.classList.add('active');
      document.body.style.overflow = 'hidden';
    }
    function closeSidebar() {
      sidebar.classList.remove('active');
      overlay.classList.remove('active');
      document.body.style.overflow = '';
    }

    if (openBtn) openBtn.addEventListener('click', openSidebar);
    if (closeBtn) closeBtn.addEventListener('click', closeSidebar);
    if (overlay) overlay.addEventListener('click', closeSidebar);

    /* ====== Cart Sidebar ====== */
    var cartOpenBtn = document.getElementById('ppCartSidebarOpen');
    var cartCloseBtn = document.getElementById('ppCartSidebarClose');
    var cartOverlay = document.getElementById('ppCartSidebarOverlay');
    var cartSidebar = document.getElementById('ppCartSidebar');
    var cartItemsEl = document.getElementById('ppCartSidebarItems');
    var cartFooterEl = document.getElementById('ppCartSidebarFooter');
    var cartSubtotalEl = document.getElementById('ppCartSidebarSubtotal');

    function formatMoney(cents) {
      return '\u20AA' + (cents / 100).toFixed(2);
    }

    function openCartSidebar() {
      cartSidebar.classList.add('active');
      cartOverlay.classList.add('active');
      document.body.style.overflow = 'hidden';
      refreshCartSidebar();
    }

    function closeCartSidebar() {
      cartSidebar.classList.remove('active');
      cartOverlay.classList.remove('active');
      document.body.style.overflow = '';
    }

    function refreshCartSidebar() {
      fetch('/cart.js')
        .then(function(r) { return r.json(); })
        .then(function(cart) { renderCartSidebar(cart); })
        .catch(function() {});
    }

    function renderCartSidebar(cart) {
      if (!cart.items || cart.items.length === 0) {
        cartItemsEl.innerHTML =
          '<div class="pp-cart-sidebar__empty">' +
            '<div class="pp-cart-sidebar__empty-icon">\uD83D\uDC3E</div>' +
            '<h3>\u05D4\u05E1\u05DC \u05E8\u05D9\u05E7</h3>' +
            '<a href="/collections/all" class="pp-cart-sidebar__empty-btn">\u05D4\u05DE\u05E9\u05DA \u05DC\u05E7\u05E0\u05D5\u05EA</a>' +
          '</div>';
        cartFooterEl.style.display = 'none';
        return;
      }

      var html = '';
      cart.items.forEach(function(item, index) {
        var imgSrc = item.image ? item.image.replace(/(\.[a-z]+)(\?|$)/, '_200x200$1$2') : '';
        var variantHtml = item.variant_title && item.variant_title !== 'Default Title'
          ? '<p class="pp-cart-sidebar__item-variant">' + item.variant_title + '</p>'
          : '';

        html +=
          '<div class="pp-cart-sidebar__item" data-line="' + (index + 1) + '" data-key="' + item.key + '">' +
            '<div class="pp-cart-sidebar__item-img">' +
              (imgSrc ? '<img src="' + imgSrc + '" alt="' + item.title + '" loading="lazy">' : '') +
            '</div>' +
            '<div class="pp-cart-sidebar__item-details">' +
              '<p class="pp-cart-sidebar__item-title">' + item.product_title + '</p>' +
              variantHtml +
              '<span class="pp-cart-sidebar__item-price">' + formatMoney(item.final_line_price) + '</span>' +
              '<div class="pp-cart-sidebar__item-actions">' +
                '<div class="pp-cart-sidebar__qty">' +
                  '<button type="button" class="pp-cart-sidebar__qty-btn" data-action="plus" data-key="' + item.key + '">+</button>' +
                  '<span class="pp-cart-sidebar__qty-val">' + item.quantity + '</span>' +
                  '<button type="button" class="pp-cart-sidebar__qty-btn" data-action="minus" data-key="' + item.key + '">\u2212</button>' +
                '</div>' +
                '<button type="button" class="pp-cart-sidebar__item-remove" data-key="' + item.key + '" aria-label="\u05D4\u05E1\u05E8">' +
                  '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>' +
                '</button>' +
              '</div>' +
            '</div>' +
          '</div>';
      });

      cartItemsEl.innerHTML = html;
      cartSubtotalEl.textContent = formatMoney(cart.total_price);
      cartFooterEl.style.display = 'block';
    }

    function updateCartSidebarItem(key, quantity) {
      fetch('/cart/change.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: key, quantity: quantity })
      })
        .then(function(r) { return r.json(); })
        .then(function(cart) {
          renderCartSidebar(cart);
          // Update header badge
          var badge = document.getElementById('ppCartCount');
          if (badge) {
            badge.textContent = cart.item_count;
            badge.setAttribute('data-count', cart.item_count);
            badge.style.display = cart.item_count > 0 ? 'flex' : 'none';
          }
          document.querySelectorAll('.pp-mobile-cart-count').forEach(function(el) {
            el.textContent = cart.item_count;
          });
        })
        .catch(function() {});
    }

    // Event delegation for cart sidebar buttons
    cartItemsEl.addEventListener('click', function(e) {
      var plusBtn = e.target.closest('[data-action="plus"]');
      var minusBtn = e.target.closest('[data-action="minus"]');
      var removeBtn = e.target.closest('.pp-cart-sidebar__item-remove');

      if (plusBtn) {
        var valEl = plusBtn.closest('.pp-cart-sidebar__qty').querySelector('.pp-cart-sidebar__qty-val');
        var newQty = parseInt(valEl.textContent, 10) + 1;
        updateCartSidebarItem(plusBtn.getAttribute('data-key'), newQty);
      }
      if (minusBtn) {
        var valEl2 = minusBtn.closest('.pp-cart-sidebar__qty').querySelector('.pp-cart-sidebar__qty-val');
        var newQty2 = parseInt(valEl2.textContent, 10) - 1;
        updateCartSidebarItem(minusBtn.getAttribute('data-key'), Math.max(0, newQty2));
      }
      if (removeBtn) {
        updateCartSidebarItem(removeBtn.getAttribute('data-key'), 0);
      }
    });

    if (cartOpenBtn) cartOpenBtn.addEventListener('click', openCartSidebar);
    if (cartCloseBtn) cartCloseBtn.addEventListener('click', closeCartSidebar);
    if (cartOverlay) cartOverlay.addEventListener('click', closeCartSidebar);

    // Expose globally so pets-paradise.js can call it
    window.ppOpenCartSidebar = openCartSidebar;
    window.ppRefreshCartSidebar = refreshCartSidebar;
  })();
</script>

