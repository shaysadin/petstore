<style>
  .pp-header-section .shopify-section-header-group { display: contents; }

  /* === Dropdown Menu === */
  .pp-navbar__dropdown {
    position: relative;
  }
  .pp-navbar__dropdown .pp-nav-link {
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .pp-navbar__dropdown .pp-nav-link svg {
    transition: transform 0.25s ease;
  }
  .pp-navbar__dropdown:hover .pp-nav-link svg {
    transform: rotate(180deg);
  }
  .pp-navbar__dropdown-menu {
    position: absolute;
    top: 100%;
    right: 0;
    min-width: 220px;
    background: var(--pp-white);
    border-radius: 12px;
    box-shadow: 0 8px 32px rgba(80, 30, 21, 0.15);
    padding: 8px 0;
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition: opacity 0.25s ease, transform 0.25s ease, visibility 0.25s ease;
    z-index: 100;
    direction: rtl;
  }
  .pp-navbar__dropdown:hover .pp-navbar__dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  .pp-navbar__dropdown-link {
    display: block;
    padding: 10px 20px;
    font-family: var(--pp-font);
    font-size: 15px;
    font-weight: 500;
    color: var(--pp-brown);
    text-decoration: none;
    transition: background 0.15s, color 0.15s, padding-right 0.15s;
  }
  .pp-navbar__dropdown-link:hover {
    background: var(--pp-cream);
    color: var(--pp-orange);
    padding-right: 24px;
  }
  .pp-navbar__cart-count {
    position: absolute;
    top: -6px;
    right: -6px;
    background: var(--pp-brown);
    color: var(--pp-cream);
    font-family: var(--pp-font);
    font-size: 11px;
    font-weight: 700;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }
  .pp-navbar__cart-count:empty,
  .pp-navbar__cart-count[data-count="0"] { display: none; }

  /* Search bar vertical spacing */
  .pp-navbar__search {
    margin: 8px 0 !important;
  }

  /* ====== Mobile Sidebar ====== */
  .pp-sidebar-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.5);
    z-index: 9998;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }
  .pp-sidebar-overlay.active {
    opacity: 1;
    visibility: visible;
  }

  .pp-sidebar {
    position: fixed;
    top: 0;
    right: -320px;
    width: 300px;
    max-width: 85vw;
    height: 100vh;
    height: 100dvh;
    background: var(--pp-white);
    z-index: 9999;
    transition: right 0.35s cubic-bezier(0.25, 0.8, 0.25, 1);
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    box-shadow: -4px 0 24px rgba(0,0,0,0.15);
    direction: rtl;
  }
  .pp-sidebar.active {
    right: 0;
  }

  .pp-sidebar__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 20px 16px;
    border-bottom: 1px solid rgba(80,30,21,0.08);
  }
  .pp-sidebar__logo {
    font-family: var(--pp-font);
    font-size: 20px;
    font-weight: 800;
    color: var(--pp-orange);
    text-decoration: none;
  }
  .pp-sidebar__close {
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s;
    color: var(--pp-brown);
  }
  .pp-sidebar__close:hover {
    background: var(--pp-cream);
  }

  .pp-sidebar__search {
    padding: 16px 20px;
    border-bottom: 1px solid rgba(80,30,21,0.08);
  }
  .pp-sidebar__search form {
    display: flex;
    align-items: center;
    background: var(--pp-cream);
    border-radius: 12px;
    padding: 10px 14px;
    gap: 8px;
  }
  .pp-sidebar__search input {
    border: none;
    background: transparent;
    font-family: var(--pp-font);
    font-size: 15px;
    color: var(--pp-brown);
    outline: none;
    width: 100%;
  }
  .pp-sidebar__search input::placeholder { color: rgba(80,30,21,0.4); }
  .pp-sidebar__search button {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    display: flex;
    color: var(--pp-orange);
  }

  .pp-sidebar__nav {
    padding: 12px 0;
    flex: 1;
  }
  .pp-sidebar__nav-item {
    border-bottom: 1px solid rgba(80,30,21,0.05);
  }
  .pp-sidebar__nav-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 20px;
    font-family: var(--pp-font);
    font-size: 16px;
    font-weight: 600;
    color: var(--pp-brown);
    text-decoration: none;
    transition: background 0.2s, color 0.2s;
  }
  .pp-sidebar__nav-link:hover {
    background: var(--pp-cream);
    color: var(--pp-orange);
  }
  .pp-sidebar__nav-link svg {
    transition: transform 0.3s ease;
    flex-shrink: 0;
  }
  .pp-sidebar__nav-item.open > .pp-sidebar__nav-link svg {
    transform: rotate(90deg);
  }

  /* Collapsible sub-menu */
  .pp-sidebar__submenu {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.35s ease;
    background: var(--pp-cream);
  }
  .pp-sidebar__nav-item.open > .pp-sidebar__submenu {
    max-height: 500px;
  }
  .pp-sidebar__submenu a {
    display: block;
    padding: 12px 36px;
    font-family: var(--pp-font);
    font-size: 15px;
    color: var(--pp-brown);
    text-decoration: none;
    transition: color 0.2s, padding-right 0.2s;
  }
  .pp-sidebar__submenu a:hover {
    color: var(--pp-orange);
    padding-right: 42px;
  }

  .pp-sidebar__footer {
    padding: 20px;
    border-top: 1px solid rgba(80,30,21,0.08);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .pp-sidebar__footer-link {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--pp-font);
    font-size: 15px;
    font-weight: 600;
    color: var(--pp-brown);
    text-decoration: none;
    padding: 10px 0;
    transition: color 0.2s;
  }
  .pp-sidebar__footer-link:hover { color: var(--pp-orange); }
  .pp-sidebar__footer-link svg { color: var(--pp-orange); flex-shrink: 0; }

  /* ====== Cart Sidebar ====== */
  .pp-cart-sidebar-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.5);
    z-index: 9998;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }
  .pp-cart-sidebar-overlay.active {
    opacity: 1;
    visibility: visible;
  }

  .pp-cart-sidebar {
    position: fixed;
    top: 0;
    left: -420px;
    width: 400px;
    max-width: 90vw;
    height: 100vh;
    height: 100dvh;
    background: var(--pp-white);
    z-index: 9999;
    transition: left 0.35s cubic-bezier(0.25, 0.8, 0.25, 1);
    display: flex;
    flex-direction: column;
    box-shadow: 4px 0 24px rgba(0,0,0,0.15);
    direction: rtl;
  }
  .pp-cart-sidebar.active {
    left: 0;
  }

  .pp-cart-sidebar__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 24px 16px;
    border-bottom: 1px solid rgba(80,30,21,0.08);
  }
  .pp-cart-sidebar__title {
    font-family: var(--pp-font);
    font-size: 20px;
    font-weight: 800;
    color: var(--pp-brown);
    margin: 0;
  }
  .pp-cart-sidebar__close {
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s;
    color: var(--pp-brown);
  }
  .pp-cart-sidebar__close:hover {
    background: var(--pp-cream);
  }

  .pp-cart-sidebar__items {
    flex: 1;
    overflow-y: auto;
    padding: 16px 24px;
  }

  .pp-cart-sidebar__item {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    padding: 14px 0;
    border-bottom: 1px solid rgba(80,30,21,0.06);
  }
  .pp-cart-sidebar__item:last-child {
    border-bottom: none;
  }

  .pp-cart-sidebar__item-img {
    width: 64px;
    height: 64px;
    border-radius: 10px;
    overflow: hidden;
    flex-shrink: 0;
  }
  .pp-cart-sidebar__item-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .pp-cart-sidebar__item-details {
    flex: 1;
    min-width: 0;
  }
  .pp-cart-sidebar__item-title {
    font-family: var(--pp-font);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--pp-brown);
    margin: 0 0 2px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .pp-cart-sidebar__item-variant {
    font-family: var(--pp-font);
    font-size: 0.8rem;
    color: #9a8a82;
    margin: 0 0 6px;
  }
  .pp-cart-sidebar__item-price {
    font-family: var(--pp-font);
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--pp-brown);
  }

  .pp-cart-sidebar__item-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 8px;
  }

  .pp-cart-sidebar__qty {
    display: inline-flex;
    align-items: center;
    background: var(--pp-cream);
    border-radius: 8px;
    border: 1px solid #e8ddd4;
    overflow: hidden;
  }
  .pp-cart-sidebar__qty-btn {
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--pp-brown);
    font-size: 0.95rem;
    font-weight: 600;
    transition: background 0.15s;
  }
  .pp-cart-sidebar__qty-btn:hover {
    background: rgba(80,30,21,0.08);
  }
  .pp-cart-sidebar__qty-val {
    width: 28px;
    text-align: center;
    font-family: var(--pp-font);
    font-size: 0.85rem;
    font-weight: 700;
    color: #501E15;
    user-select: none;
  }

  .pp-cart-sidebar__item-remove {
    background: none;
    border: none;
    cursor: pointer;
    color: #c0a89e;
    padding: 4px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
    margin-inline-start: auto;
  }
  .pp-cart-sidebar__item-remove:hover {
    background: #fde8e0;
    color: #e74c3c;
  }

  .pp-cart-sidebar__footer {
    padding: 20px 24px;
    border-top: 1px solid rgba(80,30,21,0.08);
  }
  .pp-cart-sidebar__subtotal {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
    font-family: var(--pp-font);
  }
  .pp-cart-sidebar__subtotal-label {
    font-size: 0.95rem;
    font-weight: 600;
    color: #7a6a62;
  }
  .pp-cart-sidebar__subtotal-value {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--pp-brown);
  }

  .pp-cart-sidebar__checkout {
    display: block;
    width: 100%;
    padding: 14px 24px;
    background: var(--pp-orange);
    color: var(--pp-white);
    font-family: var(--pp-font);
    font-size: 1rem;
    font-weight: 700;
    text-align: center;
    text-decoration: none;
    border: none;
    border-radius: 12px;
    cursor: pointer;
    transition: background 0.2s, transform 0.15s;
    margin-bottom: 10px;
  }
  .pp-cart-sidebar__checkout:hover {
    background: var(--pp-brown);
    transform: translateY(-1px);
    color: var(--pp-white);
  }

  .pp-cart-sidebar__view-cart {
    display: block;
    text-align: center;
    font-family: var(--pp-font);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--pp-brown);
    text-decoration: underline;
    transition: color 0.2s;
  }
  .pp-cart-sidebar__view-cart:hover {
    color: var(--pp-orange);
  }

  .pp-cart-sidebar__empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 60px 20px;
    text-align: center;
    flex: 1;
  }
  .pp-cart-sidebar__empty-icon {
    font-size: 48px;
    margin-bottom: 16px;
    line-height: 1;
  }
  .pp-cart-sidebar__empty h3 {
    font-family: var(--pp-font);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--pp-brown);
    margin: 0 0 16px;
  }
  .pp-cart-sidebar__empty-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 32px;
    background: var(--pp-orange);
    color: var(--pp-white);
    font-family: var(--pp-font);
    font-size: 1rem;
    font-weight: 600;
    border-radius: 12px;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: all 0.2s;
  }
  .pp-cart-sidebar__empty-btn:hover {
    background: var(--pp-brown);
    color: var(--pp-white);
  }
</style>

<header class="pp-navbar" data-section-id="{{ section.id }}">
  <div style="display:flex;align-items:center;justify-content:space-between;width:100%;max-width:1920px;margin:0 auto;padding:0 34px;">
    {%- comment -%} Logo {%- endcomment -%}
    <div class="pp-navbar__logo-wrap">
      <a href="{{ routes.root_url }}" style="text-decoration:none;">
        {%- if section.settings.logo -%}
          <img class="pp-navbar__logo" src="{{ section.settings.logo | image_url: width: 424 }}" alt="{{ shop.name }}" width="212" height="21">
        {%- else -%}
          <span class="pp-navbar__logo-text">Pets Paradise</span>
        {%- endif -%}
      </a>
    </div>

    {%- comment -%} Nav links (desktop) with dropdowns {%- endcomment -%}
    {%- assign nav_menu = linklists[section.settings.menu] -%}
    <nav class="pp-navbar__nav d-none d-lg-flex">
      {%- if nav_menu.links.size > 0 -%}
        {%- for link in nav_menu.links -%}
          {%- if link.links.size > 0 -%}
            <div class="pp-navbar__nav-item pp-navbar__dropdown">
              <a href="{{ link.url }}" class="pp-nav-link" title="{{ link.title }}">
                {{ link.title }}
                <svg width="10" height="6" viewBox="0 0 10 6" fill="none" style="margin-right:4px;"><path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
              </a>
              <div class="pp-navbar__dropdown-menu">
                {%- for child in link.links -%}
                  <a href="{{ child.url }}" class="pp-navbar__dropdown-link">{{ child.title }}</a>
                {%- endfor -%}
              </div>
            </div>
          {%- else -%}
            <div class="pp-navbar__nav-item">
              <a href="{{ link.url }}" class="pp-nav-link" title="{{ link.title }}">{{ link.title }}</a>
            </div>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </nav>

    <div style="display:flex;align-items:center;gap:16px;">
      {%- comment -%} Search bar (desktop) {%- endcomment -%}
      <form action="{{ routes.search_url }}" method="get" class="pp-navbar__search d-none d-md-flex">
        <input type="text" name="q" placeholder="{{ section.settings.search_placeholder | default: 'חיפוש מוצר' }}" autocomplete="off">
        <button type="submit" style="background:none;border:none;cursor:pointer;padding:0;display:flex;align-items:center;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M21 21L15 15M17 10C17 13.866 13.866 17 10 17C6.13401 17 3 13.866 3 10C3 6.13401 6.13401 3 10 3C13.866 3 17 6.13401 17 10Z" stroke="rgba(0,0,0,0.4)" stroke-width="2" stroke-linecap="round"/></svg>
        </button>
      </form>

      {%- comment -%} Cart + Wishlist {%- endcomment -%}
      <div class="pp-navbar__icons">
        <button type="button" class="pp-navbar__icon" id="ppCartSidebarOpen" aria-label="עגלת קניות" style="position:relative;background:none;border:none;cursor:pointer;padding:0;">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none"><path d="M6 2L3 6V20C3 20.5304 3.21071 21.0391 3.58579 21.4142C3.96086 21.7893 4.46957 22 5 22H19C19.5304 22 20.0391 21.7893 20.4142 21.4142C20.7893 21.0391 21 20.5304 21 20V6L18 2H6Z" stroke="#FFFFFF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M3 6H21" stroke="#FFFFFF" stroke-width="1.5"/><path d="M16 10C16 11.0609 15.5786 12.0783 14.8284 12.8284C14.0783 13.5786 13.0609 14 12 14C10.9391 14 9.92172 13.5786 9.17157 12.8284C8.42143 12.0783 8 11.0609 8 10" stroke="#FFFFFF" stroke-width="1.5" stroke-linecap="round"/></svg>
          <span class="pp-navbar__cart-count" id="ppCartCount" data-count="{{ cart.item_count }}">{{ cart.item_count }}</span>
        </button>
        <a href="/pages/wishlist" class="pp-navbar__icon" aria-label="מועדפים">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none"><path d="M20.84 4.61C20.3292 4.099 19.7228 3.69365 19.0554 3.41708C18.3879 3.14052 17.6725 2.99817 16.95 2.99817C16.2275 2.99817 15.5121 3.14052 14.8446 3.41708C14.1772 3.69365 13.5708 4.099 13.06 4.61L12 5.67L10.94 4.61C9.9083 3.57831 8.50903 2.99871 7.05 2.99871C5.59096 2.99871 4.19169 3.57831 3.16 4.61C2.1283 5.64169 1.54871 7.04097 1.54871 8.5C1.54871 9.95903 2.1283 11.3583 3.16 12.39L12 21.23L20.84 12.39C21.351 11.8792 21.7563 11.2728 22.0329 10.6054C22.3095 9.93789 22.4518 9.22249 22.4518 8.5C22.4518 7.77751 22.3095 7.0621 22.0329 6.39464C21.7563 5.72718 21.351 5.12075 20.84 4.61Z" stroke="#FFFFFF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>

      {%- comment -%} Mobile hamburger {%- endcomment -%}
      <button class="d-lg-none" type="button" id="ppSidebarOpen" aria-label="תפריט" style="background:none;border:none;padding:0;cursor:pointer;">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none"><path d="M3 12H21M3 6H21M3 18H21" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round"/></svg>
      </button>
    </div>
  </div>
</header>

{%- comment -%} Mobile Sidebar Overlay {%- endcomment -%}
<div class="pp-sidebar-overlay" id="ppSidebarOverlay"></div>

{%- comment -%} Mobile Sidebar {%- endcomment -%}
<div class="pp-sidebar" id="ppSidebar">
  <div class="pp-sidebar__header">
    <a href="{{ routes.root_url }}" class="pp-sidebar__logo">Pets Paradise</a>
    <button class="pp-sidebar__close" id="ppSidebarClose" aria-label="סגור">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M18 6L6 18M6 6L18 18" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>
    </button>
  </div>

  <div class="pp-sidebar__search">
    <form action="{{ routes.search_url }}" method="get">
      <input type="text" name="q" placeholder="חיפוש מוצר..." autocomplete="off">
      <button type="submit">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M21 21L15 15M17 10C17 13.866 13.866 17 10 17C6.13401 17 3 13.866 3 10C3 6.13401 6.13401 3 10 3C13.866 3 17 6.13401 17 10Z" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      </button>
    </form>
  </div>

  <div class="pp-sidebar__nav">
    {%- if nav_menu.links.size > 0 -%}
      {%- for link in nav_menu.links -%}
        {%- if link.links.size > 0 -%}
          <div class="pp-sidebar__nav-item">
            <a href="#" class="pp-sidebar__nav-link" onclick="event.preventDefault();this.parentElement.classList.toggle('open');">
              {{ link.title }}
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            </a>
            <div class="pp-sidebar__submenu">
              <a href="{{ link.url }}">כל {{ link.title }}</a>
              {%- for child in link.links -%}
                <a href="{{ child.url }}">{{ child.title }}</a>
              {%- endfor -%}
            </div>
          </div>
        {%- else -%}
          <div class="pp-sidebar__nav-item">
            <a href="{{ link.url }}" class="pp-sidebar__nav-link">{{ link.title }}</a>
          </div>
        {%- endif -%}
      {%- endfor -%}
    {%- else -%}
      <div class="pp-sidebar__nav-item"><a href="/collections/כלבים" class="pp-sidebar__nav-link">כלבים</a></div>
      <div class="pp-sidebar__nav-item"><a href="/collections/חתולים" class="pp-sidebar__nav-link">חתולים</a></div>
      <div class="pp-sidebar__nav-item"><a href="/collections/מזון-יבש" class="pp-sidebar__nav-link">מזון לבעלי חיים</a></div>
      <div class="pp-sidebar__nav-item"><a href="/collections/חטיפים" class="pp-sidebar__nav-link">חטיפים</a></div>
