<section class="pp-hero">
  {%- if section.settings.background_image -%}
    <img class="pp-hero__bg pp-hero__bg--desktop" src="{{ section.settings.background_image | image_url: width: 1920 }}" alt="" loading="eager" fetchpriority="high" decoding="async">
  {%- else -%}
    <img class="pp-hero__bg pp-hero__bg--desktop" src="{{ 'hero-bg.png' | asset_url }}" alt="" loading="eager" fetchpriority="high" decoding="async">
  {%- endif -%}
  <img class="pp-hero__bg pp-hero__bg--mobile" src="{{ 'hero-bg-mobile.png' | asset_url }}" alt="" loading="eager" fetchpriority="high" decoding="async">

  <div class="pp-hero__inner">
    {%- comment -%} Text content (right side in RTL) {%- endcomment -%}
    <div class="pp-hero__content">
      <h1 class="pp-h1">{{ section.settings.heading }}</h1>
      <p class="pp-body pp-hero__text">{{ section.settings.text }}</p>
      {%- if section.settings.button_text != blank -%}
        <a href="{{ section.settings.button_url | default: '/collections/all' }}" class="pp-btn pp-btn--primary">
          {{ section.settings.button_text }}
        </a>
      {%- endif -%}
    </div>

    {%- comment -%} Hero image (left side in RTL) - only show if uploaded via admin {%- endcomment -%}
    {%- if section.settings.hero_image -%}
      <div class="pp-hero__image-wrap">
        <img src="{{ section.settings.hero_image | image_url: width: 1200 }}" alt="" loading="eager">
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "PP Hero Banner",
  "class": "pp-hero-section",
  "settings": [
    { "type": "image_picker", "id": "background_image", "label": "תמונת רקע (עם דוגמת כפות)" },
    { "type": "image_picker", "id": "hero_image", "label": "תמונת גיבור (כלב/חתול)" },
    { "type": "text", "id": "heading", "default": "גן עדן לחיות כל מה שהחבר על ארבע צריך במקום אחד!", "label": "כותרת" },
    { "type": "textarea", "id": "text", "default": "אנחנו יודעים כמה הם חשובים לך. לכן יצרנו מקום אחד שבו תמצאי את כל מה שהם צריכים מזון איכותי, מיטות מפנקות, צעצועים, מוצרי טיפוח ואביזרים במחירים נוחים ובשירות שמרגיש אישי. כאן לא קונים סתם מוצר. כאן מפנקים באהבה.", "label": "טקסט" },
    { "type": "text", "id": "button_text", "default": "קנה עכשיו", "label": "טקסט כפתור" },
    { "type": "url", "id": "button_url", "label": "קישור כפתור" }
  ],
  "presets": [{ "name": "PP Hero Banner" }]
}
{% endschema %}
