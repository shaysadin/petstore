{% doc %}
  Hero carousel with 3 slides, animated text, decorative shapes.
{% enddoc %}

<div class="th-hero-wrapper hero-3" id="hero">
  <div class="hero-bg-shape3" data-bg-src="{{ 'hero-paw-bg.png' | asset_url }}"></div>
  <div class="shape-mockup moving hero-shape-3-1" data-top="14%" data-right="54%">
    <img src="{{ 'shape-shape1-42.png' | asset_url }}" alt="">
  </div>
  <div class="shape-mockup jump hero-shape-3-2" data-top="35%" data-left="6%">
    <img src="{{ 'shape-shape1-43.png' | asset_url }}" alt="">
  </div>
  <div class="shape-mockup jump-reverse hero-shape-3-3" data-top="50%" data-right="42%">
    <img src="{{ 'shape-shape1-44.png' | asset_url }}" alt="">
  </div>
  <div class="swiper th-slider" id="heroSlider8" data-slider-options='{"effect":"fade","autoplay":false,"autoHeight":true}'>
    <div class="swiper-wrapper">
      {%- for block in section.blocks -%}
        <div class="swiper-slide" {{ block.shopify_attributes }}>
          <div class="hero-inner">
            <div class="container th-container">
              <div class="row gy-40 align-items-center">
                <div class="col-lg-6">
                  <div class="hero-style3">
                    <span class="sub-title style3"><img class="logo" src="{{ 'shape-hero-shape-3.png' | asset_url }}" alt=""> {{ block.settings.subtitle }}</span>
                    <h1 class="hero-title">{{ block.settings.heading }}</h1>
                    <p class="hero-text">{{ block.settings.text }}</p>
                    <a href="{{ block.settings.button_url }}" class="th-btn style3">{{ block.settings.button_text }}</a>
                  </div>
                </div>
                <div class="col-lg-6">
                  <div class="hero3-img">
                    {%- if block.settings.image != blank -%}
                      <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.heading | escape }}">
                    {%- else -%}
                      {%- assign slide_images = 'hero3-1.png,hero3-2.png,hero3-3.png' | split: ',' -%}
                      {%- assign slide_index = forloop.index0 | modulo: 3 -%}
                      <img src="{{ slide_images[slide_index] | asset_url }}" alt="">
                    {%- endif -%}
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>
    <div class="slider-pagination"></div>
  </div>
</div>

{% stylesheet %}
  /* Static hero background — outside swiper, no slide animation */
  .hero-3 {
    position: relative;
  }
  .hero-3 > .hero-bg-shape3 {
    position: absolute;
    inset: 0 40px;
    border-radius: 100px;
    z-index: 0;
    opacity: 0;
    animation: heroBgFade 0.6s ease-out 0.1s forwards;
  }
  @keyframes heroBgFade {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @media (max-width: 1700px) {
    .hero-3 > .hero-bg-shape3 { inset: 0 0px; }
  }
  @media (max-width: 1600px) {
    .hero-3 > .hero-bg-shape3 { inset: 0 30px; }
  }
  @media (max-width: 767px) {
    .hero3-img:before {
      left: 10px;
      border-radius: 40px;
    }
  }
  @media (max-width: 575px) {
    .hero-3 > .hero-bg-shape3 { inset: 0 0px; border-radius: 50px; }
  }

  /* Hide original text inside swiper immediately — overlay clone handles display */
  .hero-3 .swiper-slide .hero-style3 {
    visibility: hidden;
  }

  /* Text overlay — always visible, outside Swiper */
  .hero-text-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 10;
    pointer-events: none;
  }
  .hero-text-overlay .hero-style3 {
    pointer-events: auto;
  }

  /* Smooth entrance animations */
  @keyframes heroFadeUp {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .hero-text-overlay .sub-title {
    opacity: 0;
    animation: heroFadeUp 0.8s ease-out 0.2s forwards;
  }
  .hero-text-overlay .hero-title {
    opacity: 0;
    animation: heroFadeUp 0.8s ease-out 0.4s forwards;
  }
  .hero-text-overlay .hero-text {
    opacity: 0;
    animation: heroFadeUp 0.8s ease-out 0.6s forwards;
  }
  .hero-text-overlay .th-btn {
    opacity: 0;
    animation: heroFadeUp 0.8s ease-out 0.8s forwards;
  }
  .hero3-img {
    opacity: 0;
    animation: heroFadeUp 0.8s ease-out 0.8s forwards;
  }

  /* Image fade — first child is always relative to hold height */
  .hero-img-slide {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    opacity: 0;
    transition: opacity 1s ease-in-out;
  }
  .hero-img-slide:first-child {
    position: relative;
  }
  .hero-img-slide.is-active {
    opacity: 1;
  }
  /* Center and bottom-align images 2 & 3 inside the frame */
  .hero-img-slide:not(:first-child) {
    height: 100%;
    display: flex;
    align-items: flex-end;
    justify-content: center;
  }
  .hero-img-slide:not(:first-child) img {
    max-height: 100%;
    object-fit: contain;
  }
{% endstylesheet %}

{% javascript %}
  (function() {
    var hero = document.querySelector('.th-hero-wrapper.hero-3');
    if (!hero) return;

    /* ---- TEXT OVERLAY ---- */
    var firstText = hero.querySelector('.swiper-slide .hero-style3');
    if (firstText) {
      hero.style.position = 'relative';

      var clone = firstText.cloneNode(true);
      clone.querySelectorAll('[data-ani]').forEach(function(el) {
        el.removeAttribute('data-ani');
        el.removeAttribute('data-ani-delay');
      });

      var overlay = document.createElement('div');
      overlay.className = 'hero-text-overlay';

      var inner = document.createElement('div');
      inner.className = 'hero-inner';

      var container = document.createElement('div');
      container.className = 'container th-container';

      var row = document.createElement('div');
      row.className = 'row gy-40 align-items-center';

      var col = document.createElement('div');
      col.className = 'col-lg-6';

      col.appendChild(clone);
      row.appendChild(col);
      container.appendChild(row);
      inner.appendChild(container);
      overlay.appendChild(inner);
      hero.appendChild(overlay);

      hero.querySelectorAll('.swiper-slide .hero-style3').forEach(function(el) {
        el.style.visibility = 'hidden';
      });
    }

    /* ---- IMAGE VERTICAL SLIDER ---- */
    var imgContainer = hero.querySelector('.swiper-slide-active .hero3-img') ||
                       hero.querySelector('.swiper-slide .hero3-img');
    if (!imgContainer) return;

    // Collect images from all slides
    var allSlides = hero.querySelectorAll('.swiper-slide');
    var images = [];
    allSlides.forEach(function(slide) {
      var img = slide.querySelector('.hero3-img img');
      if (img) images.push(img.cloneNode(true));
    });

    if (images.length <= 1) return;

    // Clear existing img and insert wrapped slides
    var existingImgs = imgContainer.querySelectorAll('img');
    existingImgs.forEach(function(img) { img.remove(); });

    images.forEach(function(img, i) {
      var wrapper = document.createElement('div');
      wrapper.className = 'hero-img-slide' + (i === 0 ? ' is-active' : '');
      wrapper.appendChild(img);
      imgContainer.appendChild(wrapper);
    });

    // Simple fade cycle
    var current = 0;
    var total = images.length;
    var slideEls = imgContainer.querySelectorAll('.hero-img-slide');

    setInterval(function() {
      slideEls[current].classList.remove('is-active');
      current = (current + 1) % total;
      slideEls[current].classList.add('is-active');
    }, 4000);
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Hero carousel",
  "settings": [],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "מוצרים טבעיים לחיות מחמד"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "המוצרים הטובים ביותר לחיות שלכם!"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "מרכיבים אורגניים באיכות הגבוהה ביותר למגוון מוצרים טבעיים 100% לחיות מחמד."
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button text",
          "default": "גלו את המוצרים"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Button link"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Slide image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero carousel",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
