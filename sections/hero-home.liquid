{% doc %}
  Hero carousel with 3 slides, animated text, decorative shapes.
{% enddoc %}

<div class="th-hero-wrapper hero-3" id="hero">
  <div class="shape-mockup moving hero-shape-3-1" data-top="14%" data-right="54%">
    <img src="{{ 'shape-shape1-42.png' | asset_url }}" alt="">
  </div>
  <div class="shape-mockup jump hero-shape-3-2" data-top="35%" data-left="6%">
    <img src="{{ 'shape-shape1-43.png' | asset_url }}" alt="">
  </div>
  <div class="shape-mockup jump-reverse hero-shape-3-3" data-top="50%" data-right="42%">
    <img src="{{ 'shape-shape1-44.png' | asset_url }}" alt="">
  </div>
  <div class="swiper th-slider" id="heroSlider8" data-slider-options='{"effect":"fade", "autoplay":false, "autoHeight": "true"}'>
    <div class="swiper-wrapper">
      {%- for block in section.blocks -%}
        <div class="swiper-slide" {{ block.shopify_attributes }}>
          <div class="hero-bg-shape3" data-bg-src="{{ 'normal-hero3-bg-shape.png' | asset_url }}"></div>
          <div class="hero-inner">
            <div class="container th-container">
              <div class="row gy-40 align-items-center">
                <div class="col-lg-6">
                  <div class="hero-style3">
                    <span class="sub-title style3" data-ani="slideinup" data-ani-delay="0.2s"><img class="logo" src="{{ 'shape-hero-shape-3.png' | asset_url }}" alt=""> {{ block.settings.subtitle }}</span>
                    <h1 class="hero-title" data-ani="slideinup" data-ani-delay="0.4s">{{ block.settings.heading }}</h1>
                    <p class="hero-text" data-ani="slideinup" data-ani-delay="0.6s">{{ block.settings.text }}</p>
                    <a href="{{ block.settings.button_url }}" data-ani="slideinup" data-ani-delay="0.8s" class="th-btn style3">{{ block.settings.button_text }}</a>
                  </div>
                </div>
                <div class="col-lg-6">
                  <div class="hero3-img" data-ani="slideinup" data-ani-delay="0.8s">
                    {%- if block.settings.image != blank -%}
                      <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.heading | escape }}">
                    {%- else -%}
                      {%- assign slide_images = 'hero3-1.png,hero3-2.png,hero3-3.png' | split: ',' -%}
                      {%- assign slide_index = forloop.index0 | modulo: 3 -%}
                      <img src="{{ slide_images[slide_index] | asset_url }}" alt="">
                    {%- endif -%}
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>
    <div class="slider-pagination"></div>
  </div>
</div>

{% schema %}
{
  "name": "Hero carousel",
  "settings": [],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "מוצרים טבעיים לחיות מחמד"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "המוצרים הטובים ביותר לחיות שלכם!"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "מרכיבים אורגניים באיכות הגבוהה ביותר למגוון מוצרים טבעיים 100% לחיות מחמד."
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button text",
          "default": "גלו את המוצרים"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Button link"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Slide image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero carousel",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
