<section class="e-hero full-width no-padding">
  <div class="e-hero__inner">
    <div class="e-hero__content">
      <header class="e-hero__header">
        <h1 class="e-hero__heading h-display-type__one js-anim h-animate-in-slide-up">
          {{ section.settings.heading }}
        </h1>
        {% if section.settings.subtitle != blank %}
          <h2 class="e-hero__heading-sub js-anim h-animate-in-slide-up">
            {{ section.settings.subtitle }}
          </h2>
        {% endif %}
      </header>
    </div>
  </div>
  <div class="e-hero__media">
    {% if section.settings.video_url != blank %}
      <video class="js-video js-video-lazy" autoplay playsinline loop muted preload="metadata">
        <source data-src="{{ section.settings.video_url }}" type="video/mp4">
      </video>
    {% endif %}
    {% if section.settings.poster_image != blank %}
      {{ section.settings.poster_image | image_url: width: 1920 | image_tag:
        class: 'e-hero__poster',
        loading: 'eager',
        fetchpriority: 'high',
        alt: section.settings.heading
      }}
    {% else %}
      <img class="e-hero__poster" src="https://images.unsplash.com/photo-1548199973-03cce0bbc87b?w=1920&h=1080&fit=crop&q=80" alt="Hero" loading="eager" fetchpriority="high">
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .e-hero {
    position: relative;
    background-color: #000;
  }
  @media (min-width: 1280px) { .e-hero { height: 894px; } }
  @media (max-width: 1060px) {
    .e-hero {
      background-color: #fff;
      display: flex;
      flex-direction: column-reverse;
    }
  }

  .e-hero__inner {
    width: 100%;
    margin-right: auto;
    margin-left: auto;
    max-width: var(--large-container);
    padding-right: var(--spacing);
    padding-left: var(--spacing);
    height: inherit;
    position: relative;
    z-index: 2;
  }
  @media (max-width: 1060px) {
    .e-hero__inner { height: auto; width: 100%; }
  }

  .e-hero__content {
    height: inherit;
    width: 58%;
    display: flex;
    align-items: center;
    justify-content: flex-start;
  }
  @media (max-width: 1060px) {
    .e-hero__content {
      width: 100%;
      max-width: 660px;
      margin-left: auto;
      margin-right: auto;
    }
  }

  @media (max-width: 1060px) {
    .e-hero__header {
      text-align: center;
      padding-bottom: 0;
      margin-top: 50px;
    }
  }

  .e-hero__heading,
  .e-hero__heading-sub { color: #fff; }
  @media (max-width: 1060px) {
    .e-hero__heading,
    .e-hero__heading-sub { color: var(--brand-1); }
  }

  .e-hero__heading { margin-top: 0; }
  @media (max-width: 1060px) { .e-hero__heading { text-align: center; } }

  .e-hero__heading-sub { font-size: 28px; font-weight: 500; }
  @media (max-width: 1460px) { .e-hero__heading-sub { font-size: 24px; } }
  @media (max-width: 1260px) { .e-hero__heading-sub { font-size: 20px; } }
  @media (max-width: 1060px) { .e-hero__heading-sub { font-size: 18px; } }

  .e-hero__media {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }
  @media (max-width: 1060px) {
    .e-hero__media { position: relative; aspect-ratio: 4/3; }
  }

  .e-hero__media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .e-hero__poster {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: block;
    transition: opacity 0.2s ease-in-out;
    z-index: 0;
    object-fit: cover;
    object-position: center;
    max-width: none;
  }

  .e-hero .js-video-ready .e-hero__poster { opacity: 0; }
{% endstylesheet %}

{% javascript %}
  document.querySelectorAll('.js-video-lazy').forEach(function (video) {
    var source = video.querySelector('source[data-src]');
    if (source) {
      source.src = source.dataset.src;
      video.load();
      video.addEventListener('playing', function () {
        video.parentElement.classList.add('js-video-ready');
      });
    }
  });
{% endjavascript %}

{% schema %}
{
  "name": "t:general.hero",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "The future of exceptional pet food and treats"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "t:labels.subtitle",
      "default": "Pet Paradise is dedicated to creating the best possible pet food and treats for pets. We don't just uphold industry standards; we set them through innovation, attention to detail, provenance, and best practices."
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "t:labels.video_url",
      "info": "Direct URL to MP4 video file"
    },
    {
      "type": "image_picker",
      "id": "poster_image",
      "label": "t:labels.poster_image"
    }
  ],
  "presets": [
    {
      "name": "t:general.hero"
    }
  ]
}
{% endschema %}
