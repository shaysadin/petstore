<div class="pp-product-page">
  <nav class="pp-breadcrumb">
    <a href="/">דף הבית</a>
    <span class="pp-breadcrumb__sep">&rsaquo;</span>
    {%- if product.collections.size > 0 -%}
      <a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a>
      <span class="pp-breadcrumb__sep">&rsaquo;</span>
    {%- endif -%}
    <span>{{ product.title }}</span>
  </nav>

  <div class="pp-product-page__inner">
    {%- comment -%} Product images {%- endcomment -%}
    <div class="pp-product-page__gallery">
      <div class="pp-product-page__main-img">
        {%- if product.featured_image -%}
          <img src="{{ product.featured_image | image_url: width: 900 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" id="pp-main-img">
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
      {%- if product.images.size > 1 -%}
        <div class="pp-product-page__thumbs">
          {%- for image in product.images -%}
            <button class="pp-product-page__thumb{% if forloop.first %} active{% endif %}" data-src="{{ image | image_url: width: 900 }}">
              <img src="{{ image | image_url: width: 150 }}" alt="{{ image.alt | escape }}" loading="lazy">
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} Product info {%- endcomment -%}
    <div class="pp-product-page__info">
      <div class="pp-product-page__availability">
        {%- if product.available -%}
          <span class="pp-product-page__stock pp-product-page__stock--in">במלאי</span>
        {%- else -%}
          <span class="pp-product-page__stock pp-product-page__stock--out">אזל מהמלאי</span>
        {%- endif -%}
        {%- if product.compare_at_price > product.price -%}
          <span class="pp-product-page__badge pp-product-page__badge--sale">מבצע!</span>
        {%- endif -%}
      </div>

      <h1 class="pp-product-page__title">{{ product.title }}</h1>

      <div class="pp-product-page__price">
        <span class="pp-product-page__price-current">{{ product.price | money_without_trailing_zeros }}</span>
        {%- if product.compare_at_price > product.price -%}
          <span class="pp-product-page__price-compare">{{ product.compare_at_price | money_without_trailing_zeros }}</span>
          {%- assign savings = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price -%}
          <span class="pp-product-page__price-savings">חיסכון של {{ savings }}%</span>
        {%- endif -%}
      </div>

      <div class="pp-product-page__divider"></div>

      {%- comment -%} Collapsible Tabs (replaces description) {%- endcomment -%}
      <div class="pp-product-tabs">
        <div class="pp-product-tab open">
          <button class="pp-product-tab__header" onclick="this.parentElement.classList.toggle('open')">
            <span>תיאור המוצר</span>
            <svg class="pp-product-tab__icon" width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <div class="pp-product-tab__body">
            {%- if product.description != blank -%}
              {{ product.description }}
            {%- else -%}
              <p>אין תיאור זמין למוצר זה.</p>
            {%- endif -%}
          </div>
        </div>
        <div class="pp-product-tab">
          <button class="pp-product-tab__header" onclick="this.parentElement.classList.toggle('open')">
            <span>משלוחים והחזרות</span>
            <svg class="pp-product-tab__icon" width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <div class="pp-product-tab__body">
            <p><strong>משלוח:</strong> משלוח חינם בהזמנה מעל ₪149. זמן אספקה: 3-5 ימי עסקים.</p>
            <p><strong>החזרות:</strong> ניתן להחזיר מוצרים תוך 14 יום מיום הקבלה, באריזה מקורית ובלי שימוש.</p>
            <p><strong>שירות לקוחות:</strong> זמינים עבורכם בטלפון 055-660-0934 או במייל Petsparadiseld@gmail.com</p>
          </div>
        </div>
        <div class="pp-product-tab">
          <button class="pp-product-tab__header" onclick="this.parentElement.classList.toggle('open')">
            <span>מדיניות אחריות</span>
            <svg class="pp-product-tab__icon" width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <div class="pp-product-tab__body">
            <p><strong>אחריות:</strong> כל המוצרים מגיעים עם אחריות מלאה מהיצרן.</p>
            <p><strong>איכות:</strong> אנחנו עובדים רק עם מותגים מוכרים ואיכותיים כדי להבטיח את שביעות רצונכם.</p>
            <p><strong>תמיכה:</strong> נשמח לעזור בכל שאלה — צרו איתנו קשר בכל עת.</p>
          </div>
        </div>
      </div>

      {% form 'product', product %}
        {{ form.errors | default_errors }}

        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            <div class="pp-product-page__option">
              <label class="pp-product-page__option-label">{{ option.name }}</label>
              <select name="id" class="pp-product-page__select">
                {%- for variant in product.variants -%}
                  <option value="{{ variant.id }}"{% if variant == product.selected_or_first_available_variant %} selected{% endif %}{% unless variant.available %} disabled{% endunless %}>
                    {{ variant.title }} - {{ variant.price | money_without_trailing_zeros }}
                  </option>
                {%- endfor -%}
              </select>
            </div>
          {%- endfor -%}
        {%- else -%}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        {%- endunless -%}

        <div class="pp-product-page__actions">
          <div class="pp-qty pp-qty--large" id="ppProductQty">
            <button class="pp-qty__btn pp-qty__plus" type="button" aria-label="הוסף" onclick="var i=document.getElementById('ppQtyVal');var s=document.getElementById('ppQtyDisplay');var v=parseInt(i.value)+1;i.value=v;s.textContent=v;">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"><path fill="currentColor" d="M19 12.998h-6v6h-2v-6H5v-2h6v-6h2v6h6z"/></svg>
            </button>
            <input type="hidden" name="quantity" value="1" id="ppQtyVal">
            <span id="ppQtyDisplay" class="pp-qty__display">1</span>
            <button class="pp-qty__btn pp-qty__minus" type="button" aria-label="הפחת" onclick="var i=document.getElementById('ppQtyVal');var s=document.getElementById('ppQtyDisplay');var v=parseInt(i.value);if(v>1){i.value=v-1;s.textContent=v-1;}">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"><path fill="currentColor" d="M5 12.998h14v-2H5z"/></svg>
            </button>
          </div>
          <button type="submit" class="pp-btn pp-btn--primary pp-product-page__add-btn"{% unless product.available %} disabled{% endunless %}>
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
            {%- if product.available -%}הוסף לסל{%- else -%}אזל מהמלאי{%- endif -%}
          </button>
        </div>
        {%- if product.available -%}
          <a href="/checkout?line_items[][variant_id]={{ product.selected_or_first_available_variant.id }}&line_items[][quantity]=1" class="pp-product-page__buy-now">
            קנה עכשיו
          </a>
        {%- endif -%}
      {% endform %}


      <div class="pp-product-page__trust">
        <div class="pp-product-page__trust-item">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
          <span>משלוח מהיר</span>
        </div>
        <div class="pp-product-page__trust-item">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          <span>תשלום מאובטח</span>
        </div>
        <div class="pp-product-page__trust-item">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          <span>אחריות מלאה</span>
        </div>
      </div>

      <div class="pp-product-page__meta">
        {%- if product.vendor != blank -%}
          <span>יצרן: <a href="{{ product.vendor | url_for_vendor }}">{{ product.vendor }}</a></span>
        {%- endif -%}
        {%- if product.type != blank -%}
          <span>סוג: <a href="{{ product.type | url_for_type }}">{{ product.type }}</a></span>
        {%- endif -%}
        {%- if product.tags.size > 0 -%}
          <span>תגיות:
            {%- for tag in product.tags -%}
              <a href="/collections/all/{{ tag | handle }}">{{ tag }}{% unless forloop.last %}, {% endunless %}</a>
            {%- endfor -%}
          </span>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

<style>
  /* === Product Page === */
  .pp-product-page {
    max-width: 1440px;
    margin: 0 auto;
    padding: 30px 40px 80px;
    overflow: visible;
  }
  .pp-product-page .pp-breadcrumb {
    font-family: var(--pp-font);
    font-size: 14px;
    color: var(--pp-brown);
    opacity: 0.6;
    margin-bottom: 32px;
    display: flex;
    gap: 4px;
    align-items: center;
  }
  .pp-product-page .pp-breadcrumb a { color: inherit; text-decoration: none; transition: opacity 0.2s; }
  .pp-product-page .pp-breadcrumb a:hover { opacity: 1; text-decoration: underline; }
  .pp-product-page .pp-breadcrumb__sep { margin: 0 2px; font-size: 16px; }

  .pp-product-page__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: start;
    position: relative;
  }

  /* === Gallery === */
  .pp-product-page__gallery {
    align-self: start;
  }
  .pp-product-page__main-img {
    background: var(--pp-cream);
    border-radius: 20px;
    overflow: hidden;
    margin-bottom: 16px;
    box-shadow: 0 2px 12px rgba(0,0,0,0.08);
  }
  .pp-product-page__main-img img {
    width: 100%;
    display: block;
    aspect-ratio: 1/1;
    object-fit: contain;
    transition: opacity 0.3s ease;
  }
  .pp-product-page__thumbs {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
  .pp-product-page__thumb {
    width: 80px;
    height: 80px;
    border-radius: 12px;
    overflow: hidden;
    border: 2px solid transparent;
    cursor: pointer;
    background: var(--pp-cream);
    padding: 0;
    transition: border-color 0.2s, transform 0.2s;
  }
  .pp-product-page__thumb:hover {
    transform: translateY(-2px);
  }
  .pp-product-page__thumb.active {
    border-color: var(--pp-orange);
    box-shadow: 0 2px 8px rgba(247, 92, 2, 0.2);
  }
  .pp-product-page__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* === Product Info === */
  .pp-product-page__info {
    padding-top: 8px;
  }
  .pp-product-page__availability {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 16px;
  }
  .pp-product-page__stock {
    font-family: var(--pp-font);
    font-weight: 600;
    font-size: 13px;
    padding: 5px 14px;
    border-radius: 20px;
    display: inline-block;
  }
  .pp-product-page__stock--in {
    background: #e8f5e9;
    color: #2e7d32;
  }
  .pp-product-page__stock--out {
    background: #fbe9e7;
    color: #c62828;
  }
  .pp-product-page__badge {
    font-family: var(--pp-font);
    font-weight: 700;
    font-size: 13px;
    padding: 5px 14px;
    border-radius: 20px;
    display: inline-block;
  }
  .pp-product-page__badge--sale {
    background: var(--pp-orange);
    color: #fff;
  }
  .pp-product-page__title {
    font-family: var(--pp-font);
    font-size: 34px;
    font-weight: 800;
    color: var(--pp-brown);
    margin-bottom: 20px;
    line-height: 1.25;
  }
  .pp-product-page__price {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 24px;
    flex-wrap: wrap;
  }
  .pp-product-page__price-current {
    font-family: var(--pp-font);
    font-size: 30px;
    font-weight: 800;
    color: var(--pp-orange);
  }
  .pp-product-page__price-compare {
    font-family: var(--pp-font);
    font-size: 20px;
    color: var(--pp-brown);
    opacity: 0.4;
    text-decoration: line-through;
  }
  .pp-product-page__price-savings {
    font-family: var(--pp-font);
    font-size: 14px;
    font-weight: 600;
    color: #2e7d32;
    background: #e8f5e9;
    padding: 4px 12px;
    border-radius: 20px;
  }
  .pp-product-page__divider {
    height: 1px;
    background: rgba(80, 30, 21, 0.08);
    margin-bottom: 24px;
  }
  .pp-product-page__desc {
    font-family: var(--pp-font);
    font-size: 16px;
    line-height: 1.75;
    color: var(--pp-brown);
    margin-bottom: 28px;
    text-align: right;
  }
  .pp-product-page__desc * { text-align: right !important; }

  /* === Variant Options === */
  .pp-product-page__option {
    margin-bottom: 20px;
  }
  .pp-product-page__option-label {
    font-family: var(--pp-font);
    font-weight: 700;
    font-size: 15px;
    color: var(--pp-brown);
    margin-bottom: 8px;
    display: block;
  }
  .pp-product-page__select {
    width: 100%;
    padding: 12px 16px;
    font-family: var(--pp-font);
    font-size: 15px;
    border: 1.5px solid rgba(80, 30, 21, 0.15);
    border-radius: 12px;
    background: var(--pp-cream);
    color: var(--pp-brown);
    cursor: pointer;
    transition: border-color 0.2s;
    -webkit-appearance: none;
    appearance: none;
    background-image: url("data:image/svg+xml,%3Csvg width='12' height='8' viewBox='0 0 12 8' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1.5L6 6.5L11 1.5' stroke='%23501E15' stroke-width='2' stroke-linecap='round'/%3E%3C/svg%3E");
    background-repeat: no-repeat;
    background-position: 12px center;
    padding-left: 32px;
  }
  .pp-product-page__select:hover,
  .pp-product-page__select:focus {
    border-color: var(--pp-orange);
    outline: none;
  }

  /* === Actions === */
  .pp-product-page__actions {
    display: flex;
    align-items: center;
    gap: 16px;
    margin: 28px 0;
  }
  .pp-qty--large {
    gap: 0;
    border: 2px solid rgba(80, 30, 21, 0.15);
    border-radius: 30px;
    overflow: hidden;
    display: flex;
    align-items: center;
    background: var(--pp-cream);
    transition: border-color 0.2s;
    padding: 4px;
    height: 52px;
  }
  .pp-qty--large:hover,
  .pp-qty--large:focus-within {
    border-color: var(--pp-orange);
  }
  .pp-qty--large .pp-qty__btn {
    width: 52px;
    height: 52px;
    background: transparent;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--pp-orange);
    transition: background 0.2s;
  }
  .pp-qty--large .pp-qty__btn:hover {
    background: rgba(247, 92, 2, 0.08);
  }
  .pp-qty__display {
    width: 52px;
    text-align: center;
    font-family: var(--pp-font);
    font-size: 22px;
    font-weight: 800;
    color: #501E15;
    line-height: 52px;
    user-select: none;
  }
  .pp-product-page__add-btn {
    flex: 1;
    height: 52px;
    font-size: 17px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .pp-product-page__add-btn:not(:disabled):hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(247, 92, 2, 0.35);
  }

  /* === Trust Badges === */
  .pp-product-page__trust {
    display: flex;
    gap: 20px;
    padding: 20px 0;
    margin-bottom: 24px;
    border-top: 1px solid rgba(80, 30, 21, 0.08);
    border-bottom: 1px solid rgba(80, 30, 21, 0.08);
  }
  .pp-product-page__trust-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--pp-font);
    font-size: 14px;
    font-weight: 600;
    color: var(--pp-brown);
  }
  .pp-product-page__trust-item svg {
    color: var(--pp-orange);
    flex-shrink: 0;
  }

  /* === Buy Now Button === */
  .pp-product-page__buy-now {
    display: block !important;
    width: 100%;
    text-align: center;
    padding: 14px 24px;
    font-family: var(--pp-font);
    font-size: 17px;
    font-weight: 700;
    color: var(--pp-orange) !important;
    background: transparent !important;
    border: 2px solid var(--pp-orange) !important;
    border-radius: 12px;
    text-decoration: none;
    transition: all 0.25s ease;
    margin-bottom: 24px;
  }
  .pp-product-page__buy-now:hover {
    background: var(--pp-orange) !important;
    color: #fff !important;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(247, 92, 2, 0.3);
  }

  /* === Collapsible Tabs === */
  .pp-product-tabs {
    margin-top: 32px;
    border-top: 1px solid rgba(80, 30, 21, 0.1);
  }
  .pp-product-tab {
    border-bottom: 1px solid rgba(80, 30, 21, 0.1);
  }
  .pp-product-tab__header {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 0;
    background: none;
    border: none;
    cursor: pointer;
    font-family: var(--pp-font);
    font-size: 17px;
    font-weight: 700;
    color: var(--pp-brown);
    transition: color 0.2s;
  }
  .pp-product-tab__header:hover {
    color: var(--pp-orange);
  }
  .pp-product-tab__icon {
    color: var(--pp-brown);
    transition: transform 0.3s ease, color 0.2s;
    flex-shrink: 0;
  }
  .pp-product-tab.open .pp-product-tab__icon {
    transform: rotate(180deg);
    color: var(--pp-orange);
  }
  .pp-product-tab__body {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.35s ease, padding 0.35s ease;
    padding: 0 0;
    font-family: var(--pp-font);
    font-size: 15px;
    line-height: 1.7;
    color: var(--pp-brown);
    text-align: right;
  }
  .pp-product-tab.open .pp-product-tab__body {
    max-height: none;
    padding: 0 0 20px;
  }
  .pp-product-tab__body p {
    margin-bottom: 10px;
  }
  .pp-product-tab__body strong {
    color: var(--pp-orange);
  }

  /* === Meta === */
  .pp-product-page__meta {
    font-family: var(--pp-font);
    font-size: 14px;
    color: var(--pp-brown);
    opacity: 0.6;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .pp-product-page__meta a { color: var(--pp-orange); text-decoration: none; }
  .pp-product-page__meta a:hover { text-decoration: underline; }

  /* === Responsive === */
  @media (max-width: 992px) {
    .pp-product-page__inner {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .pp-product-page__gallery { position: static; }
  }
  @media (max-width: 768px) {
    .pp-product-page { padding: 20px 16px 60px; }
    .pp-product-page__title { font-size: 26px; }
    .pp-product-page__price-current { font-size: 26px; }
    .pp-product-page__thumb { width: 64px; height: 64px; }
    .pp-product-page__trust { flex-direction: column; gap: 12px; }
    .pp-product-page__actions { flex-direction: column; }
    .pp-product-page__add-btn { width: 100%; }
    .pp-qty--large { align-self: stretch; justify-content: center; }
  }
  @media (max-width: 480px) {
    .pp-product-page { padding: 16px 12px 48px; }
    .pp-product-page__title { font-size: 22px; }
    .pp-product-page__price-current { font-size: 22px; }
    .pp-product-page__thumb { width: 56px; height: 56px; border-radius: 10px; }
    .pp-product-page .pp-breadcrumb { font-size: 13px; }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    var thumbs = document.querySelectorAll('.pp-product-page__thumb');
    var mainImg = document.getElementById('pp-main-img');
    if (!mainImg) return;

    thumbs.forEach(function(thumb) {
      thumb.addEventListener('click', function() {
        mainImg.style.opacity = '0';
        setTimeout(function() {
          mainImg.src = thumb.getAttribute('data-src');
          mainImg.style.opacity = '1';
        }, 150);
        thumbs.forEach(function(t) { t.classList.remove('active'); });
        thumb.classList.add('active');
      });
    });

  });

  // Sticky gallery via JS — uses a wrapper to preserve grid space
  (function() {
    var gallery = document.querySelector('.pp-product-page__gallery');
    var inner = document.querySelector('.pp-product-page__inner');
    if (!gallery || !inner || window.innerWidth < 993) return;

    // Wrap gallery in a holder div that stays in the grid
    var holder = document.createElement('div');
    holder.className = 'pp-product-page__gallery-holder';
    gallery.parentNode.insertBefore(holder, gallery);
    holder.appendChild(gallery);

    var topOffset = 90;
    var state = 'static';

    function onScroll() {
      if (window.innerWidth < 993) {
        if (state !== 'static') {
          state = 'static';
          gallery.style.cssText = '';
        }
        return;
      }

      var holderRect = holder.getBoundingClientRect();
      var innerRect = inner.getBoundingClientRect();
      var galleryH = gallery.offsetHeight;
      var galleryW = holder.offsetWidth;

      var shouldFix = holderRect.top < topOffset;
      var reachedBottom = innerRect.bottom < galleryH + topOffset;

      if (!shouldFix) {
        if (state !== 'static') {
          state = 'static';
          gallery.style.cssText = '';
        }
      } else if (shouldFix && !reachedBottom) {
        if (state !== 'fixed') {
          state = 'fixed';
          gallery.style.cssText = 'position:fixed;top:' + topOffset + 'px;width:' + galleryW + 'px;z-index:10;';
        }
      } else {
        if (state !== 'bottom') {
          state = 'bottom';
          var bottomPos = inner.offsetHeight - galleryH;
          gallery.style.cssText = 'position:absolute;bottom:0;width:' + galleryW + 'px;z-index:10;';
        }
      }
    }

    // Set holder to take the gallery's grid space
    holder.style.alignSelf = 'start';

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', function() {
      if (window.innerWidth < 993) {
        state = 'static';
        gallery.style.cssText = '';
      }
    });

    onScroll();
  })();
</script>

