<div class="pp-product-page">
  <nav class="pp-breadcrumb">
    <a href="/">דף הבית</a>
    <span class="pp-breadcrumb__sep">/</span>
    {%- if product.collections.size > 0 -%}
      <a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a>
      <span class="pp-breadcrumb__sep">/</span>
    {%- endif -%}
    <span>{{ product.title }}</span>
  </nav>

  <div class="pp-product-page__inner">
    {%- comment -%} Product images {%- endcomment -%}
    <div class="pp-product-page__gallery">
      <div class="pp-product-page__main-img">
        {%- if product.featured_image -%}
          <img src="{{ product.featured_image | image_url: width: 900 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" id="pp-main-img">
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
      {%- if product.images.size > 1 -%}
        <div class="pp-product-page__thumbs">
          {%- for image in product.images -%}
            <button class="pp-product-page__thumb{% if forloop.first %} active{% endif %}" data-src="{{ image | image_url: width: 900 }}">
              <img src="{{ image | image_url: width: 150 }}" alt="{{ image.alt | escape }}" loading="lazy">
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} Product info {%- endcomment -%}
    <div class="pp-product-page__info">
      <h1 class="pp-product-page__title">{{ product.title }}</h1>

      <div class="pp-product-page__price">
        <span class="pp-product-page__price-current">{{ product.price | money_without_trailing_zeros }}</span>
        {%- if product.compare_at_price > product.price -%}
          <span class="pp-product-page__price-compare">{{ product.compare_at_price | money_without_trailing_zeros }}</span>
        {%- endif -%}
      </div>

      {%- if product.description != blank -%}
        <div class="pp-product-page__desc">{{ product.description }}</div>
      {%- endif -%}

      <div class="pp-product-page__availability">
        {%- if product.available -%}
          <span class="pp-product-page__stock pp-product-page__stock--in">במלאי</span>
        {%- else -%}
          <span class="pp-product-page__stock pp-product-page__stock--out">אזל מהמלאי</span>
        {%- endif -%}
      </div>

      {% form 'product', product %}
        {{ form.errors | default_errors }}

        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            <div class="pp-product-page__option">
              <label class="pp-product-page__option-label">{{ option.name }}</label>
              <select name="id" class="pp-product-page__select">
                {%- for variant in product.variants -%}
                  <option value="{{ variant.id }}"{% if variant == product.selected_or_first_available_variant %} selected{% endif %}{% unless variant.available %} disabled{% endunless %}>
                    {{ variant.title }} - {{ variant.price | money_without_trailing_zeros }}
                  </option>
                {%- endfor -%}
              </select>
            </div>
          {%- endfor -%}
        {%- else -%}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        {%- endunless -%}

        <div class="pp-product-page__actions">
          <div class="pp-qty pp-qty--large">
            <button class="pp-qty__btn pp-qty__plus" type="button" aria-label="הוסף">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="currentColor" d="M19 12.998h-6v6h-2v-6H5v-2h6v-6h2v6h6z"/></svg>
            </button>
            <input type="number" name="quantity" value="1" min="1" max="100" class="pp-qty__input">
            <button class="pp-qty__btn pp-qty__minus" type="button" aria-label="הפחת">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="currentColor" d="M5 12.998h14v-2H5z"/></svg>
            </button>
          </div>
          <button type="submit" class="pp-btn pp-btn--primary pp-product-page__add-btn"{% unless product.available %} disabled{% endunless %}>
            {%- if product.available -%}הוסף לסל{%- else -%}אזל מהמלאי{%- endif -%}
          </button>
        </div>
      {% endform %}

      <div class="pp-product-page__meta">
        {%- if product.vendor != blank -%}
          <span>יצרן: <a href="{{ product.vendor | url_for_vendor }}">{{ product.vendor }}</a></span>
        {%- endif -%}
        {%- if product.type != blank -%}
          <span>סוג: <a href="{{ product.type | url_for_type }}">{{ product.type }}</a></span>
        {%- endif -%}
        {%- if product.tags.size > 0 -%}
          <span>תגיות:
            {%- for tag in product.tags -%}
              <a href="/collections/all/{{ tag | handle }}">{{ tag }}{% unless forloop.last %}, {% endunless %}</a>
            {%- endfor -%}
          </span>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

<style>
  .pp-product-page {
    max-width: 1440px;
    margin: 0 auto;
    padding: 30px 34px 80px;
  }
  .pp-product-page .pp-breadcrumb {
    font-family: var(--pp-font);
    font-size: 14px;
    color: var(--pp-brown);
    opacity: 0.6;
    margin-bottom: 30px;
  }
  .pp-product-page .pp-breadcrumb a { color: inherit; text-decoration: none; }
  .pp-product-page .pp-breadcrumb a:hover { text-decoration: underline; }
  .pp-product-page .pp-breadcrumb__sep { margin: 0 8px; }

  .pp-product-page__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: start;
  }
  .pp-product-page__gallery { position: sticky; top: 100px; }
  .pp-product-page__main-img {
    background: var(--pp-cream);
    border-radius: 20px;
    overflow: hidden;
    margin-bottom: 16px;
  }
  .pp-product-page__main-img img {
    width: 100%;
    display: block;
    aspect-ratio: 1/1;
    object-fit: contain;
  }
  .pp-product-page__thumbs {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
  .pp-product-page__thumb {
    width: 80px;
    height: 80px;
    border-radius: 12px;
    overflow: hidden;
    border: 2px solid transparent;
    cursor: pointer;
    background: var(--pp-cream);
    padding: 0;
    transition: border-color 0.2s;
  }
  .pp-product-page__thumb.active { border-color: var(--pp-orange); }
  .pp-product-page__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .pp-product-page__title {
    font-family: var(--pp-heading-font);
    font-size: 32px;
    font-weight: 700;
    color: var(--pp-brown);
    margin-bottom: 16px;
  }
  .pp-product-page__price {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
  }
  .pp-product-page__price-current {
    font-family: var(--pp-font);
    font-size: 28px;
    font-weight: 700;
    color: var(--pp-orange);
  }
  .pp-product-page__price-compare {
    font-family: var(--pp-font);
    font-size: 20px;
    color: var(--pp-brown);
    opacity: 0.4;
    text-decoration: line-through;
  }
  .pp-product-page__desc {
    font-family: var(--pp-font);
    font-size: 16px;
    line-height: 1.7;
    color: var(--pp-brown);
    margin-bottom: 20px;
    text-align: right;
  }
  .pp-product-page__desc * { text-align: right !important; }
  .pp-product-page__availability { margin-bottom: 24px; }
  .pp-product-page__stock {
    font-family: var(--pp-font);
    font-weight: 600;
    font-size: 15px;
    padding: 6px 16px;
    border-radius: 20px;
    display: inline-block;
  }
  .pp-product-page__stock--in {
    background: #e8f5e9;
    color: #2e7d32;
  }
  .pp-product-page__stock--out {
    background: #fbe9e7;
    color: #c62828;
  }
  .pp-product-page__option {
    margin-bottom: 20px;
  }
  .pp-product-page__option-label {
    font-family: var(--pp-font);
    font-weight: 700;
    font-size: 15px;
    color: var(--pp-brown);
    margin-bottom: 8px;
    display: block;
  }
  .pp-product-page__select {
    width: 100%;
    padding: 12px 16px;
    font-family: var(--pp-font);
    font-size: 15px;
    border: 1px solid #ddd;
    border-radius: 12px;
    background: #fff;
    color: var(--pp-brown);
  }
  .pp-product-page__actions {
    display: flex;
    align-items: center;
    gap: 16px;
    margin: 28px 0;
  }
  .pp-qty--large {
    gap: 0;
    border: 2px solid var(--pp-orange);
    border-radius: 12px;
    overflow: hidden;
    display: flex;
    align-items: center;
  }
  .pp-qty--large .pp-qty__btn {
    width: 48px;
    height: 48px;
    background: transparent;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--pp-orange);
  }
  .pp-qty--large .pp-qty__input {
    width: 50px;
    text-align: center;
    border: none;
    font-family: var(--pp-font);
    font-size: 18px;
    font-weight: 700;
    color: var(--pp-brown);
    -moz-appearance: textfield;
    background: transparent;
  }
  .pp-qty--large .pp-qty__input::-webkit-outer-spin-button,
  .pp-qty--large .pp-qty__input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }
  .pp-product-page__add-btn {
    flex: 1;
    height: 52px;
    font-size: 18px;
    font-weight: 700;
  }
  .pp-product-page__meta {
    font-family: var(--pp-font);
    font-size: 14px;
    color: var(--pp-brown);
    opacity: 0.6;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .pp-product-page__meta a { color: var(--pp-orange); text-decoration: none; }
  .pp-product-page__meta a:hover { text-decoration: underline; }
  @media (max-width: 992px) {
    .pp-product-page__inner {
      grid-template-columns: 1fr;
      gap: 30px;
    }
    .pp-product-page__gallery { position: static; }
  }
  @media (max-width: 768px) {
    .pp-product-page { padding: 20px 16px 60px; }
    .pp-product-page__title { font-size: 24px; }
    .pp-product-page__price-current { font-size: 24px; }
    .pp-product-page__thumb { width: 60px; height: 60px; }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    var thumbs = document.querySelectorAll('.pp-product-page__thumb');
    var mainImg = document.getElementById('pp-main-img');
    if (!mainImg) return;

    thumbs.forEach(function(thumb) {
      thumb.addEventListener('click', function() {
        mainImg.src = this.getAttribute('data-src');
        thumbs.forEach(function(t) { t.classList.remove('active'); });
        this.classList.add('active');
      });
    });

    // Product page quantity buttons
    var qtyInput = document.querySelector('.pp-qty--large .pp-qty__input');
    if (qtyInput) {
      var plusBtn = document.querySelector('.pp-qty--large .pp-qty__plus');
      var minusBtn = document.querySelector('.pp-qty--large .pp-qty__minus');
      if (plusBtn) plusBtn.addEventListener('click', function() {
        qtyInput.value = parseInt(qtyInput.value, 10) + 1;
      });
      if (minusBtn) minusBtn.addEventListener('click', function() {
        var v = parseInt(qtyInput.value, 10);
        if (v > 1) qtyInput.value = v - 1;
      });
    }
  });
</script>

{% schema %}
{
  "name": "Product"
}
{% endschema %}
