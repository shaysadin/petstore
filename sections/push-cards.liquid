{% comment %}
  Stock images used as fallbacks when no image is set in theme editor.
{% endcomment %}
{%- assign fallback_images = 'https://images.unsplash.com/photo-1601758228041-f3b2795255f1?w=1600&h=900&fit=crop&q=80,https://images.unsplash.com/photo-1583337130417-13104dec14a4?w=1600&h=900&fit=crop&q=80,https://images.unsplash.com/photo-1589924691995-400dc9ecc119?w=1600&h=900&fit=crop&q=80,https://images.unsplash.com/photo-1586671267731-da2cf3ceeb80?w=1600&h=900&fit=crop&q=80' | split: ',' -%}

<section class="e-push-card">
  <div class="e-push-card__items">
    {% for block in section.blocks %}
      <article class="e-push-card__item js-anim h-animate-in-slide-up" {{ block.shopify_attributes }}>
        <div class="e-push-card__item--media">
          {% if block.settings.image != blank %}
            {{ block.settings.image | image_url: width: 1600 | image_tag:
              loading: 'lazy',
              alt: block.settings.heading
            }}
          {% else %}
            <img src="{{ fallback_images[forloop.index0] | default: fallback_images[0] }}" alt="{{ block.settings.heading }}" loading="lazy">
          {% endif %}
          <div class="e-push-card__item--overlay-cover"></div>
          <div class="e-push-card__item--overlay">
            {% if block.settings.overlay_title != blank %}
              <h3 class="e-push-card__item--overlay-title">{{ block.settings.overlay_title }}</h3>
            {% endif %}
            {% if block.settings.overlay_message != blank %}
              <p class="e-push-card__item--overlay-message">{{ block.settings.overlay_message }}</p>
            {% endif %}
          </div>
        </div>
        <div class="e-push-card__item--content">
          <header class="e-push-card__item--header">
            <h3 class="e-push-card__item--heading h-display-type__three js-anim h-animate-in-slide-up">
              {{ block.settings.heading }}
            </h3>
          </header>
          <p class="e-push-card__item--intro h-display-type__intro js-anim h-animate-in-slide-up">
            {{ block.settings.intro }}
          </p>
          {% if block.settings.button_text != blank %}
            <a class="e-push-card__item--btn e-btn js-anim h-animate-in-slide-up"
               href="{{ block.settings.button_url | default: '#' }}"
               aria-label="{{ block.settings.button_text }}">
              {{ block.settings.button_text }}
            </a>
          {% endif %}
        </div>
      </article>
    {% endfor %}
  </div>
</section>

{% stylesheet %}
  .e-push-card {
    margin-top: 100px;
    margin-bottom: 100px;
  }
  @media (max-width: 760px) { .e-push-card { margin-top: 45px; margin-bottom: 45px; } }

  .e-push-card__items {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 90px;
  }
  @media (max-width: 1260px) { .e-push-card__items { gap: 40px; } }
  @media (max-width: 1060px) { .e-push-card__items { gap: 20px; } }
  @media (max-width: 760px) {
    .e-push-card__items { grid-template-columns: repeat(1, minmax(0, 1fr)); gap: 50px; }
  }

  .e-push-card__item {
    border-radius: 40px;
    background-color: var(--brand-2);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .e-push-card__item--media {
    aspect-ratio: 16/9;
    border-radius: 40px;
    overflow: hidden;
    position: relative;
    z-index: 1;
    width: 100%;
  }
  @media (max-width: 1060px) { .e-push-card__item--media { aspect-ratio: 4/3; } }

  .e-push-card__item--media picture,
  .e-push-card__item--media img { display: block; width: 100%; height: 100%; max-width: none; }
  .e-push-card__item--media img { object-fit: cover; object-position: center; }

  .e-push-card__item--overlay-cover {
    background: linear-gradient(20deg, rgba(0, 0, 0, 0.3) 0%, rgba(0, 0, 0, 0.12) 100%);
    width: 100%;
    height: 100%;
    display: block;
    position: absolute;
    top: 0;
    left: 0;
  }

  .e-push-card__item--overlay {
    position: absolute;
    z-index: 2;
    top: 0;
    right: 0;
    color: #fff;
    text-align: right;
    padding: 40px 40px 0 0;
    width: 70%;
    max-width: 380px;
  }
  @media (max-width: 760px) {
    .e-push-card__item--overlay {
      bottom: 23px;
      top: initial;
      right: 11px;
      padding: 20px 20px 0 0;
    }
  }

  .e-push-card__item--overlay-title,
  .e-push-card__item--overlay-message { margin-top: 0; margin-bottom: 0; }

  .e-push-card__item--overlay-title {
    font-family: var(--secondary-font);
    font-size: 100px;
    line-height: 0.85;
  }
  @media (max-width: 1660px) { .e-push-card__item--overlay-title { font-size: 90px; } }
  @media (max-width: 1460px) { .e-push-card__item--overlay-title { font-size: 80px; } }
  @media (max-width: 1260px) { .e-push-card__item--overlay-title { font-size: 70px; } }
  @media (max-width: 560px)  { .e-push-card__item--overlay-title { font-size: 63px; } }

  .e-push-card__item--overlay-message {
    font-size: 22px;
    text-shadow: 0px 0px 10px rgba(0, 0, 0, 0.8);
  }
  @media (max-width: 1260px) { .e-push-card__item--overlay-message { font-size: 18px; } }

  .e-push-card__item--heading { margin-top: 0; }

  .e-push-card__item--content {
    text-align: center;
    padding: 50px 110px;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  @media (max-width: 1260px) { .e-push-card__item--content { padding: 40px; } }
  @media (max-width: 1060px) { .e-push-card__item--content { padding: 30px 20px; } }
  @media (max-width: 760px)  { .e-push-card__item--content { padding: 30px 15px; } }

  .e-push-card__item--intro { margin-top: 0; }
  .e-push-card__item--btn { margin-top: auto; }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.push_cards",
  "settings": [],
  "blocks": [
    {
      "type": "card",
      "name": "Push card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:labels.image"
        },
        {
          "type": "text",
          "id": "overlay_title",
          "label": "t:labels.overlay_title",
          "default": "Pride"
        },
        {
          "type": "text",
          "id": "overlay_message",
          "label": "t:labels.overlay_message",
          "default": "Creating the very best pet food and treats"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:labels.heading",
          "default": "Welcome"
        },
        {
          "type": "textarea",
          "id": "intro",
          "label": "t:labels.intro",
          "default": "Everyone here is dedicated to making the very best pet food and treats from the finest ingredients."
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "t:labels.button_text",
          "default": "About us"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "t:labels.button_url"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.push_cards",
      "blocks": [
        { "type": "card" },
        { "type": "card" }
      ]
    }
  ]
}
{% endschema %}
