{% doc %}
  Search results page with styled search bar, product grid, and empty state.
{% enddoc %}

<style>
  .pp-search {
    background: var(--pp-cream);
    min-height: 60vh;
    padding-bottom: 80px;
  }

  .pp-search__header {
    text-align: center;
    padding: 48px 0 36px;
  }

  .pp-search__header h1 {
    font-family: var(--pp-font);
    font-size: 2rem;
    font-weight: 700;
    color: var(--pp-brown);
    margin: 0 0 28px;
  }

  .pp-search__container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 16px;
  }

  /* ── Search bar ── */
  .pp-search-bar {
    max-width: 640px;
    margin: 0 auto 40px;
    position: relative;
  }

  .pp-search-bar__input {
    width: 100%;
    padding: 16px 56px 16px 20px;
    font-family: var(--pp-font);
    font-size: 1.05rem;
    color: var(--pp-brown);
    background: var(--pp-white);
    border: 2px solid #e0d3c8;
    border-radius: 16px;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
    direction: rtl;
  }

  .pp-search-bar__input::placeholder {
    color: #b8a89e;
  }

  .pp-search-bar__input:focus {
    border-color: var(--pp-orange);
    box-shadow: 0 2px 20px rgba(247, 92, 2, 0.12);
  }

  .pp-search-bar__submit {
    position: absolute;
    left: 8px;
    top: 50%;
    transform: translateY(-50%);
    width: 42px;
    height: 42px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--pp-orange);
    color: var(--pp-white);
    border: none;
    border-radius: 12px;
    cursor: pointer;
    transition: background 0.2s;
  }

  .pp-search-bar__submit:hover {
    background: var(--pp-brown);
  }

  .pp-search-bar__submit svg {
    width: 20px;
    height: 20px;
  }

  /* ── Results count ── */
  .pp-search__count {
    font-family: var(--pp-font);
    font-size: 1rem;
    color: #7a6a62;
    margin-bottom: 24px;
    text-align: center;
  }

  .pp-search__count strong {
    color: var(--pp-brown);
  }

  /* ── Product grid ── */
  .pp-search-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    margin-bottom: 40px;
  }
  .pp-search-grid .pp-product-card {
    width: 100% !important;
    min-width: 0 !important;
    max-width: 100% !important;
    height: 100%;
    min-height: 0 !important;
  }

  /* ── Pagination ── */
  .pp-search-pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    padding: 32px 0;
    font-family: var(--pp-font);
  }

  .pp-search-pagination a,
  .pp-search-pagination span.current {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 40px;
    height: 40px;
    padding: 0 12px;
    border-radius: 10px;
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s;
  }

  .pp-search-pagination a {
    color: var(--pp-brown);
    background: var(--pp-white);
    border: 1px solid #e0d3c8;
  }

  .pp-search-pagination a:hover {
    background: var(--pp-orange);
    color: var(--pp-white);
    border-color: var(--pp-orange);
  }

  .pp-search-pagination span.current {
    background: var(--pp-orange);
    color: var(--pp-white);
  }

  /* ── Empty state ── */
  .pp-search-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 60px 20px;
    text-align: center;
  }

  .pp-search-empty__icon {
    width: 80px;
    height: 80px;
    margin-bottom: 24px;
    color: #d4bfb2;
  }

  .pp-search-empty h2 {
    font-family: var(--pp-font);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--pp-brown);
    margin: 0 0 12px;
  }

  .pp-search-empty p {
    font-family: var(--pp-font);
    font-size: 1rem;
    color: #7a6a62;
    margin: 0 0 8px;
    max-width: 400px;
  }

  /* ── Responsive ── */
  @media (max-width: 1024px) {
    .pp-search-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }
  }

  @media (max-width: 768px) {
    .pp-search-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }

    .pp-search__header h1 {
      font-size: 1.5rem;
    }

    .pp-search-bar__input {
      font-size: 1rem;
      padding: 14px 50px 14px 16px;
    }
  }
</style>

<section class="pp-search">
  <div class="pp-search__header">
    <h1>חיפוש</h1>

    <form action="{{ routes.search_url }}" method="get" role="search" class="pp-search-bar">
      <input type="hidden" name="type" value="product">
      <input
        type="search"
        class="pp-search-bar__input"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="מה תרצו למצוא?"
        autocomplete="off"
      >
      <button type="submit" class="pp-search-bar__submit" aria-label="חפש">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </button>
    </form>
  </div>

  <div class="pp-search__container">
    {% if search.performed %}
      {% if search.results_count == 0 %}
        <div class="pp-search-empty">
          <svg class="pp-search-empty__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            <line x1="8" y1="8" x2="14" y2="14"></line>
            <line x1="14" y1="8" x2="8" y2="14"></line>
          </svg>
          <h2>לא נמצאו תוצאות</h2>
          <p>לא מצאנו תוצאות עבור "{{ search.terms }}"</p>
          <p>נסו לחפש במילים אחרות או לעיין בקטגוריות שלנו</p>
        </div>
      {% else %}
        <p class="pp-search__count">
          נמצאו <strong>{{ search.results_count }}</strong> תוצאות עבור "<strong>{{ search.terms }}</strong>"
        </p>

        {% paginate search.results by 20 %}
          <div class="pp-search-grid">
            {% for result in search.results %}
              {% if result.object_type == 'product' %}
                {% render 'product-card-new', product: result %}
              {% endif %}
            {% endfor %}
          </div>

          {% if paginate.pages > 1 %}
            <nav class="pp-search-pagination" aria-label="דפי תוצאות">
              {{ paginate | default_pagination }}
            </nav>
          {% endif %}
        {% endpaginate %}
      {% endif %}
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Search",
  "settings": []
}
{% endschema %}
