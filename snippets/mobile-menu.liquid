{% doc %}
  Renders the mobile off-canvas menu.
{% enddoc %}

<div class="th-menu-wrapper allow-natural-scroll">
  <div class="th-menu-area text-center">
    <button class="th-menu-toggle"><i class="fal fa-times"></i></button>
    <div class="mobile-logo">
      <a href="/"><img src="{{ 'logo3.svg' | asset_url }}" alt="{{ shop.name }}"></a>
    </div>
    <div class="th-mobile-menu">
      <ul>
        {%- for link in linklists['main-menu'].links -%}
          <li{% if link.links.size > 0 %} class="menu-item-has-children"{% endif %}>
            <a href="{{ link.url }}">{{ link.title }}</a>
            {%- if link.links.size > 0 -%}
              <ul class="sub-menu">
                {%- for child in link.links -%}
                  <li{% if child.links.size > 0 %} class="menu-item-has-children"{% endif %}>
                    <a href="{{ child.url }}">{{ child.title }}</a>
                    {%- if child.links.size > 0 -%}
                      <ul class="sub-menu">
                        {%- for grandchild in child.links -%}
                          <li><a href="{{ grandchild.url }}">{{ grandchild.title }}</a></li>
                        {%- endfor -%}
                      </ul>
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
</div>
