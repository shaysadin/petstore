{%- comment -%}
  SVG wave divider.
  Accepts: type ('top'/'bottom'), color (hex, default #501E15)
{%- endcomment -%}

{%- assign wave_color = color | default: '#501E15' -%}

{%- if type == 'bottom' -%}
<svg style="display:block;width:100%;" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1920 200" preserveAspectRatio="none">
  <path d="M0 0C320 150 640 200 960 120C1280 40 1600 100 1920 0V200H0Z" fill="{{ wave_color }}"/>
</svg>
{%- else -%}
<svg style="display:block;width:100%;" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1920 200" preserveAspectRatio="none">
  <path d="M0 200C320 50 640 0 960 80C1280 160 1600 100 1920 200V0H0Z" fill="{{ wave_color }}"/>
</svg>
{%- endif -%}
