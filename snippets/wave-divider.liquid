{%- comment -%}
  SVG wave divider for section transitions.
  Accepts:
    - type: 'top' or 'bottom' (default: 'top')
    - color: hex color (default: #501E15)
{%- endcomment -%}

{%- assign wave_color = color | default: '#501E15' -%}

{%- if type == 'bottom' -%}
<svg class="pp-wave pp-wave--bottom" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1920 531" preserveAspectRatio="none" style="display:block;width:100%;">
  <path d="M0 0C0 0 400 531 960 531C1520 531 1920 0 1920 0V531H0V0Z" fill="{{ wave_color }}"/>
</svg>
{%- else -%}
<svg class="pp-wave pp-wave--top" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1920 531" preserveAspectRatio="none" style="display:block;width:100%;">
  <path d="M0 531C0 531 400 0 960 0C1520 0 1920 531 1920 531V0H0V531Z" fill="{{ wave_color }}"/>
</svg>
{%- endif -%}
